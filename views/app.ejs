<!DOCTYPE html>
<html class="dark" lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <title version="1.0">FundusGuard Ai</title>
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
  
  <link rel="stylesheet" href="../public/App.css"/>
  <script src="https://cdn.tailwindcss.com"></script>

  <% if (isHosted) { %>
    <link rel="stylesheet" href="https://kidkrishkode.github.io/fundusguardai/assets/styles/app.css"/>
    <script src="https://kidkrishkode.github.io/fundusguardai/assets/scripts/tailwind.js"></script>
  <% } else { %>
    <link rel="stylesheet" href="../assets/styles/app.css" />
    <script src="../assets/scripts/tailwind.js"></script>
  <% } %>

</head>


<body
  class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary"
  style="overflow-y: auto !important; overflow-x: hidden; height: auto !important; min-height: 100vh; position: static !important;">
  <%- header %>
  <main class="w-full pt-16 bg-surface" style="position: static !important; overflow: visible;">
    <div class="flex flex-col w-full">
      <!-- Toast Notification Container -->
      <div
        class="fixed bottom-6 right-6 z-50 flex items-center gap-space-sm px-4 py-2.5 rounded-xl bg-surface-container-highest/95 backdrop-blur-md shadow-xl text-on-surface transition-all duration-300 opacity-0 pointer-events-none translate-y-3"
        id="toast">
        <span class="material-symbols-outlined text-status-healthy text-title-md">check_circle</span>
        <span class="font-label-md text-label-md" id="toast-message">Notification</span>
      </div>
      <!-- Hero Section & System Direct Download Hub -->
      <section class="relative w-full px-margin md:px-margin-desktop py-space-xl overflow-hidden">
        <!-- Ambient Radiance Backgrounds -->
        <div
          class="absolute -top-32 -left-20 w-96 h-96 rounded-full bg-primary-container/10 blur-[100px] pointer-events-none">
        </div>
        <div
          class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-secondary-container/10 blur-[90px] pointer-events-none">
        </div>
        <div class="max-w-7xl mx-auto flex flex-col gap-space-lg relative z-10">
          <!-- Breadcrumb & Release Status Banner -->
          <div class="flex flex-wrap items-center justify-between gap-space-sm">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm border border-border-amber-glow">
              <span class="w-2 h-2 rounded-full bg-status-healthy animate-pulse"></span>
              <span class="tracking-wider uppercase font-semibold text-text-primary">OFFICIAL RELEASES</span>
              <span class="text-text-secondary">•</span>
              <span class="text-optic-disc-gold font-bold">v1.0 PRODUCTION STABLE</span>
            </div>
            <div
              class="flex items-center gap-space-xs px-3.5 py-1.5 rounded-xl bg-surface-container-low border border-border-subtle text-on-surface shadow-sm">
              <span class="material-symbols-outlined text-title-md text-primary">verified_user</span>
              <span class="font-label-md text-label-md text-text-secondary">Release Integrity:</span>
              <span class="font-label-md text-label-md font-bold text-text-primary">Clinically Validated &amp;
                Air-Gapped</span>
            </div>
          </div>
          <!-- Hero Copy -->
          <div class="flex flex-col gap-space-sm max-w-4xl">
            <h1 class="font-headline-xl text-headline-xl tracking-tight text-text-primary">
              Download FundusGuard AI for <span
                class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Every Clinical
                Platform</span>
            </h1>
            <p class="font-body-lg text-body-lg text-text-secondary leading-relaxed">
              Deploy autonomous retinal cup-to-disc ratio (CDR) quantification and glaucoma screening natively across
              desktop workstations, clinical tablets, mobile devices, and dedicated embedded diagnostic hardware.
            </p>
          </div>
          <!-- Platform Anchor Pill Bar -->
          <div
            class="flex flex-wrap items-center gap-space-xs p-1.5 rounded-xl bg-surface-container-lowest border border-border-subtle w-fit">
            <a class="px-3 py-1.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors flex items-center gap-1.5"
              href="#app-matrix">
              <span class="material-symbols-outlined text-[16px] text-primary">apps</span> Application
            </a>
            <a class="px-3 py-1.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors flex items-center gap-1.5"
              href="#embedded-hub">
              <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">memory</span> Embedded Firmware
            </a>
            <a class="px-3 py-1.5 rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container-high transition-colors flex items-center gap-1.5"
              href="#release-archive">
              <span class="material-symbols-outlined text-[16px] text-text-secondary">history</span> Version Archive
            </a>
          </div>
        </div>
      </section>
      <!-- Section 1: Unified OS App Download Grid (Windows, macOS, Linux, Android, iOS) -->
      <section class="w-full px-margin md:px-margin-desktop py-space-lg" id="app-matrix">
        <div class="max-w-7xl mx-auto flex flex-col gap-space-lg">
