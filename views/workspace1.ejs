<script>
  (function() {
    // Tab switching behavior
    const tabDual = document.getElementById('tab-dual');
    const tabImage = document.getElementById('tab-image');
    const tabForm = document.getElementById('tab-form');
    const sectionImage = document.getElementById('section-image-upload');
    const sectionForm = document.getElementById('section-clinical-form');
    const leftPane = document.getElementById('left-pane');
    const rightPane = document.getElementById('right-pane');

    const tabs = [tabDual, tabImage, tabForm];

    function activateTab(activeBtn) {
      tabs.forEach(t => {
        if (!t) return;
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('bg-surface-container-high', 'text-text-primary', 'font-semibold', 'shadow-sm');
        t.classList.add('text-text-secondary');
      });
      activeBtn.setAttribute('aria-selected', 'true');
      activeBtn.classList.remove('text-text-secondary');
      activeBtn.classList.add('bg-surface-container-high', 'text-text-primary', 'font-semibold', 'shadow-sm');
    }

    if (tabDual) {
      tabDual.addEventListener('click', () => {
        activateTab(tabDual);
        if (sectionImage) sectionImage.classList.remove('hidden');
        if (sectionForm) sectionForm.classList.remove('hidden');
        if (leftPane) leftPane.className = 'lg:col-span-5 flex flex-col space-y-space-md transition-all duration-300';
        if (rightPane) rightPane.className = 'lg:col-span-7 flex flex-col space-y-space-md transition-all duration-300';
      });
    }

    if (tabImage) {
      tabImage.addEventListener('click', () => {
        activateTab(tabImage);
        if (sectionImage) sectionImage.classList.remove('hidden');
        if (sectionForm) sectionForm.classList.add('hidden');
        if (leftPane) leftPane.className = 'lg:col-span-5 flex flex-col space-y-space-md transition-all duration-300';
        if (rightPane) rightPane.className = 'lg:col-span-7 flex flex-col space-y-space-md transition-all duration-300';
      });
    }

    if (tabForm) {
      tabForm.addEventListener('click', () => {
        activateTab(tabForm);
        if (sectionImage) sectionImage.classList.add('hidden');
        if (sectionForm) sectionForm.classList.remove('hidden');
        if (leftPane) leftPane.className = 'lg:col-span-5 flex flex-col space-y-space-md transition-all duration-300';
        if (rightPane) rightPane.className = 'lg:col-span-7 flex flex-col space-y-space-md transition-all duration-300';
      });
    }

    // Optical Viewer Layer Switcher
    const layerButtons = document.querySelectorAll('.viewer-layer-btn');
    const overlayCupDisc = document.getElementById('overlay-cupdisc');
    const overlayGradCam = document.getElementById('overlay-gradcam');
    const overlayVessel = document.getElementById('overlay-vessel');

    layerButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        layerButtons.forEach(b => {
          b.classList.remove('bg-surface-container-high', 'text-primary', 'font-semibold');
          b.classList.add('text-text-secondary');
        });
        btn.classList.add('bg-surface-container-high', 'text-primary', 'font-semibold');
        btn.classList.remove('text-text-secondary');

        const layer = btn.getAttribute('data-layer');
        if (overlayCupDisc) overlayCupDisc.classList.add('hidden');
        if (overlayGradCam) overlayGradCam.classList.add('hidden');
        if (overlayVessel) overlayVessel.classList.add('hidden');

        if (layer === 'cupdisc' && overlayCupDisc) {
          overlayCupDisc.classList.remove('hidden');
        } else if (layer === 'gradcam' && overlayGradCam) {
          overlayGradCam.classList.remove('hidden');
        } else if (layer === 'vessel' && overlayVessel) {
          overlayVessel.classList.remove('hidden');
        }
      });
    });

    // Run Analysis Micro-interaction
    const btnRun = document.getElementById('btn-run-analysis');
    if (btnRun) {
      btnRun.addEventListener('click', () => {
        btnRun.disabled = true;
        const originalText = btnRun.innerHTML;
        btnRun.innerHTML = `
          <span class="material-symbols-outlined text-[20px] animate-spin">refresh</span>
          <span>Computing TensorRT Features...</span>
        `;
        setTimeout(() => {
          btnRun.innerHTML = `
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>Inference Complete (38ms)</span>
          `;
          setTimeout(() => {
            btnRun.disabled = false;
            btnRun.innerHTML = originalText;
          }, 1500);
        }, 1100);
      });
    }

    // Demo Sample Loader
    const btnDemo = document.getElementById('btn-demo-sample');
    if (btnDemo) {
      btnDemo.addEventListener('click', () => {
        const idField = document.getElementById('patient-id');
        const nameField = document.getElementById('patient-name');
        const iopOsField = document.getElementById('iop-os');
        if (idField) idField.value = 'GL-8821-DEMO';
        if (nameField) nameField.value = 'Marcus Chen (Simulated Cohort)';
        if (iopOsField) iopOsField.value = '26.8 mmHg';
        alert('Simulated demo patient data (Patient #GL-8821) loaded successfully.');
      });
    }

    // Export Clinical Report
    const btnExport = document.getElementById('btn-export-quick');
    const btnPdf = document.getElementById('btn-dl-pdf');
    const printSummary = document.getElementById('btn-print-summary');
    const sendPacs = document.getElementById('btn-send-pacs');

    if (btnExport) btnExport.addEventListener('click', () => window.print());
    if (printSummary) printSummary.addEventListener('click', () => window.print());
    if (btnPdf) {
      btnPdf.addEventListener('click', () => {
        alert('Generating verified PDF cryptographic bundle with DICOM metadata...');
      });
    }
    if (sendPacs) {
      sendPacs.addEventListener('click', () => {
        alert('Transmitted DICOM Structured Report (SR) to PACS-STATION-04 [AET: FUNDUS_AI_01]');
      });
    }
  })();
</script></main></div><script>const tBtn=document.getElementById('theme-toggle-dash');const tIcon=document.getElementById('theme-icon-dash');const hEl=document.documentElement;tBtn&&tBtn.addEventListener('click',()=>{const isDark=hEl.classList.toggle('dark');tIcon.textContent=isDark?'light_mode':'dark_mode';localStorage.setItem('fundusguard-theme',isDark?'dark':'light');});</script></body></html>