</main>
</div>
<script>
    (function() {
      // 1. THEME SWITCHING (LIGHT / DARK)
      const themeBtn = document.getElementById('theme-toggle-dash');
      const themeIcon = document.getElementById('theme-icon-dash');
      const themeText = document.getElementById('theme-text-dash');
      const htmlEl = document.documentElement;

      function setTheme(isLight) {
        if (isLight) {
          htmlEl.classList.remove('dark');
          htmlEl.classList.add('light-theme');
          document.body.classList.add('light-theme');
          if (themeIcon) themeIcon.textContent = 'dark_mode';
          if (themeText) themeText.textContent = 'Dark Mode';
          localStorage.setItem('fundusguard-theme', 'light');
        } else {
          htmlEl.classList.add('dark');
          htmlEl.classList.remove('light-theme');
          document.body.classList.remove('light-theme');
          if (themeIcon) themeIcon.textContent = 'light_mode';
          if (themeText) themeText.textContent = 'Light Mode';
          localStorage.setItem('fundusguard-theme', 'dark');
        }
      }

      // Initialize theme from storage
      const savedTheme = localStorage.getItem('fundusguard-theme');
      if (savedTheme === 'light') {
        setTheme(true);
      } else {
        setTheme(false);
      }

      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isCurrentlyLight = htmlEl.classList.contains('light-theme');
          setTheme(!isCurrentlyLight);
        });
      }

      // TOAST HELPER
      const toastContainer = document.getElementById('toast-container');
      function showToast(message, type = 'error') {
        if (!toastContainer) return;
        const toast = document.createElement('div');
        toast.className = `pointer-events-auto px-4 py-3 rounded-xl shadow-2xl border text-sm font-medium flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 ${
          type === 'error' 
            ? 'bg-glaucoma-critical text-white border-red-400' 
            : 'bg-emerald-600 text-white border-emerald-400'
        }`;
        toast.innerHTML = `
          <span class="material-symbols-outlined text-[20px]">${type === 'error' ? 'error' : 'check_circle'}</span>
          <span>${message}</span>
        `;
        toastContainer.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      // STATE ELEMENTS
      const awaitingCard = document.getElementById('awaiting-input-card');
      const loadingCard = document.getElementById('inference-loading-card');
      const resultsContainer = document.getElementById('diagnostic-results-container');
      const stageText = document.getElementById('inference-stage-text');
      const progressBar = document.getElementById('inference-progress-bar');
      const pctText = document.getElementById('inference-pct-text');

      // INPUT / FORM ELEMENTS
      const fileBadge = document.getElementById('file-info-badge');
      const btnRemoveImg = document.getElementById('btn-remove-image');
      const fileInput = document.getElementById('fundus-file-input');
      const fileNameText = document.getElementById('file-name-text');
      const fileThumbImg = document.getElementById('file-thumb-img');
      const baseViewerImg = document.getElementById('viewer-img-base');

      const patId = document.getElementById('patient-id');
      const patName = document.getElementById('patient-name');
      const patAge = document.getElementById('patient-age');
      const iopOd = document.getElementById('iop-od');
      const iopOs = document.getElementById('iop-os');
      const bloodGlucose = document.getElementById('blood-glucose');
      const hba1c = document.getElementById('hba1c');
      const notes = document.getElementById('clinical-notes');

      let hasImageLoaded = true; // initially true with demo image
      let activeTabMode = 'dual'; // 'dual', 'image', 'form'

      // File Remove Handler
      if (btnRemoveImg) {
        btnRemoveImg.addEventListener('click', (e) => {
          e.stopPropagation();
          hasImageLoaded = false;
          if (fileBadge) fileBadge.classList.add('hidden');
          if (fileInput) fileInput.value = '';
          showToast('Retinal image scan removed.', 'error');
        });
      }

      // File Upload Handler
      if (fileInput) {
        fileInput.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) {
            const file = e.target.files[0];
            hasImageLoaded = true;
            if (fileNameText) fileNameText.textContent = file.name;
            const reader = new FileReader();
            reader.onload = function(evt) {
              if (fileThumbImg) fileThumbImg.src = evt.target.result;
              if (baseViewerImg) baseViewerImg.src = evt.target.result;
            };
            reader.readAsDataURL(file);
            if (fileBadge) fileBadge.classList.remove('hidden');
            showToast(`Uploaded ${file.name} successfully`, 'success');
          }
        });
      }

      // Form Clear button
      const btnClear = document.getElementById('btn-form-clear');
      if (btnClear) {
        btnClear.addEventListener('click', () => {
          if (patId) patId.value = '';
          if (patName) patName.value = '';
          if (patAge) patAge.value = '';
          if (iopOd) iopOd.value = '';
          if (iopOs) iopOs.value = '';
          if (bloodGlucose) bloodGlucose.value = '';
          if (hba1c) hba1c.value = '';
          if (notes) notes.value = '';
          showToast('Clinical form fields cleared.', 'success');
        });
      }

      // Reset / New Patient Session
      function resetWorkflowToInitial() {
        if (resultsContainer) resultsContainer.classList.add('hidden');
        if (loadingCard) loadingCard.classList.add('hidden');
        if (awaitingCard) awaitingCard.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (pctText) pctText.textContent = '0%';
      }

      const btnNewSession = document.getElementById('btn-new-session');
      if (btnNewSession) {
        btnNewSession.addEventListener('click', () => {
          resetWorkflowToInitial();
          showToast('Session reset. Awaiting diagnostic input.', 'success');
        });
      }

      // Load Demo Button
      const btnDemo = document.getElementById('btn-demo-sample');
      if (btnDemo) {
        btnDemo.addEventListener('click', () => {
          hasImageLoaded = true;
          if (fileBadge) fileBadge.classList.remove('hidden');
          if (fileNameText) fileNameText.textContent = 'OD_Macula_Disc_Angle50.png';
          if (fileThumbImg) fileThumbImg.src = 'https://lh3.googleusercontent.com/aida/AEtjO1UGGgYDAAMGaIMWxcjAQrj4D4oyoEfcg3dLejDsMI0dSTCh7Vu6I7BsV-eYRlV8D5Uab-2c5xOS4WBQFP9kxYC8gv9DXgwyuJ50TlRKxgVknh6Rb1x0aidkFmy7mRLL9dX4KtY1cFUr7tP-KEr9m78CPQrw0MAhpspm5eS1oW8PIhoXwgaRQjIzitB1cAYayokBlpETYyWQ3mDuMdBHwC-y_uagbFMLbH2YiZ5GgR8DfWK_XQ4YymKbnj4';
          if (baseViewerImg) baseViewerImg.src = 'https://lh3.googleusercontent.com/aida/AEtjO1UGGgYDAAMGaIMWxcjAQrj4D4oyoEfcg3dLejDsMI0dSTCh7Vu6I7BsV-eYRlV8D5Uab-2c5xOS4WBQFP9kxYC8gv9DXgwyuJ50TlRKxgVknh6Rb1x0aidkFmy7mRLL9dX4KtY1cFUr7tP-KEr9m78CPQrw0MAhpspm5eS1oW8PIhoXwgaRQjIzitB1cAYayokBlpETYyWQ3mDuMdBHwC-y_uagbFMLbH2YiZ5GgR8DfWK_XQ4YymKbnj4';

          if (patId) patId.value = 'GL-8821-DEMO';
          if (patName) patName.value = 'Marcus Chen (Simulated POAG)';
          if (patAge) patAge.value = '62';
          if (iopOd) iopOd.value = '19.0 mmHg';
          if (iopOs) iopOs.value = '26.8 mmHg';
          if (bloodGlucose) bloodGlucose.value = '142 mg/dL';
          if (hba1c) hba1c.value = '7.1%';
          if (notes) notes.value = 'Simulated cohort case. Advanced cupping and cup-to-disc ratio asymmetry in left eye. Automated perimetry indicated.';

          showToast('Demo patient #GL-8821 data & fundus scan loaded.', 'success');
        });
      }

      // Tab Switching
      const tabDual = document.getElementById('tab-dual');
      const tabImage = document.getElementById('tab-image');
      const tabForm = document.getElementById('tab-form');
      const sectionImage = document.getElementById('section-image-upload');
      const sectionForm = document.getElementById('section-clinical-form');

      const tabs = [tabDual, tabImage, tabForm];

      function setActiveTab(btn, mode) {
        activeTabMode = mode;
        tabs.forEach(t => {
          if (!t) return;
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('bg-primary-container', 'text-white', 'font-semibold', 'shadow-sm');
          t.classList.add('themed-text-muted');
        });
        btn.setAttribute('aria-selected', 'true');
        btn.classList.remove('themed-text-muted');
        btn.classList.add('bg-primary-container', 'text-white', 'font-semibold', 'shadow-sm');

        if (mode === 'dual') {
          if (sectionImage) sectionImage.classList.remove('hidden');
          if (sectionForm) sectionForm.classList.remove('hidden');
        } else if (mode === 'image') {
          if (sectionImage) sectionImage.classList.remove('hidden');
          if (sectionForm) sectionForm.classList.add('hidden');
        } else if (mode === 'form') {
          if (sectionImage) sectionImage.classList.add('hidden');
          if (sectionForm) sectionForm.classList.remove('hidden');
        }
      }

      if (tabDual) tabDual.addEventListener('click', () => setActiveTab(tabDual, 'dual'));
      if (tabImage) tabImage.addEventListener('click', () => setActiveTab(tabImage, 'image'));
      if (tabForm) tabForm.addEventListener('click', () => setActiveTab(tabForm, 'form'));

      // 2. SIMULATED INFERENCE WORKFLOW EXECUTION
      function runInferencePipeline() {
        const hasFormFields = Boolean(
          (patId && patId.value.trim()) ||
          (patName && patName.value.trim()) ||
          (iopOs && iopOs.value.trim())
        );

        // Validation based on active mode
        if (activeTabMode === 'image' && !hasImageLoaded) {
          showToast('⚠️ Input Required: Please upload a fundus photograph to proceed with Image-Only screening.');
          return;
        }

        if (activeTabMode === 'form' && !hasFormFields) {
          showToast('⚠️ Input Required: Please populate clinical biometric data to execute the risk model.');
          return;
        }

        if (activeTabMode === 'dual' && !hasImageLoaded && !hasFormFields) {
          showToast('⚠️ Input Required: Please upload a fundus photograph or fill in patient clinical data to proceed.');
          return;
        }

        // Valid - initiate animated loading state
        if (awaitingCard) awaitingCard.classList.add('hidden');
        if (resultsContainer) resultsContainer.classList.add('hidden');
        if (loadingCard) loadingCard.classList.remove('hidden');

        const stages = [
          { text: "Scanning Retinal Micro-structures & Vessels...", pct: "25%", val: 25 },
          { text: "Fitting Elliptical Optic Cup & Disc Boundaries...", pct: "52%", val: 52 },
          { text: "Computing Cup-to-Disc Ratio (CDR) & ISNT Conformance...", pct: "78%", val: 78 },
          { text: "Synthesizing Grad-CAM Heatmap & Biomarker Narrative...", pct: "100%", val: 100 }
        ];

        let currentStage = 0;
        if (stageText) stageText.textContent = stages[0].text;
        if (progressBar) progressBar.style.width = stages[0].pct;
        if (pctText) pctText.textContent = stages[0].pct;

        const interval = setInterval(() => {
          currentStage++;
          if (currentStage < stages.length) {
            if (stageText) stageText.textContent = stages[currentStage].text;
            if (progressBar) progressBar.style.width = stages[currentStage].pct;
            if (pctText) pctText.textContent = stages[currentStage].pct;
          } else {
            clearInterval(interval);
            // Finish inference after 2.5s
            setTimeout(() => {
              if (loadingCard) loadingCard.classList.add('hidden');
              if (resultsContainer) {
                resultsContainer.classList.remove('hidden');
                resultsContainer.classList.add('flex');
              }
              showToast('SPI-OWL Inference Complete · POAG Suspect Detected (38ms)', 'error');
            }, 500);
          }
        }, 550);
      }

      const btnRun = document.getElementById('btn-run-analysis');
      if (btnRun) {
        btnRun.addEventListener('click', runInferencePipeline);
      }

      const btnQuickRun = document.getElementById('btn-quick-run-placeholder');
      if (btnQuickRun) {
        btnQuickRun.addEventListener('click', () => {
          // If no image, supply demo
          if (!hasImageLoaded) {
            hasImageLoaded = true;
            if (fileBadge) fileBadge.classList.remove('hidden');
          }
          runInferencePipeline();
        });
      }

      // Optical Viewer Layer Switcher
      const layerButtons = document.querySelectorAll('.viewer-layer-btn');
      const overlayCupDisc = document.getElementById('overlay-cupdisc');
      const overlayGradCam = document.getElementById('overlay-gradcam');
      const overlayVessel = document.getElementById('overlay-vessel');

      layerButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          layerButtons.forEach(b => {
            b.classList.remove('bg-primary-container', 'text-white', 'font-semibold');
            b.classList.add('themed-text-muted');
          });
          btn.classList.add('bg-primary-container', 'text-white', 'font-semibold');
          btn.classList.remove('themed-text-muted');

          const layer = btn.getAttribute('data-layer');
          if (overlayCupDisc) overlayCupDisc.classList.add('hidden');
          if (overlayGradCam) overlayGradCam.classList.add('hidden');
          if (overlayVessel) overlayVessel.classList.add('hidden');

          if (layer === 'cupdisc' && overlayCupDisc) {
            overlayCupDisc.classList.remove('hidden');
          } else if (layer === 'gradcam' && overlayGradCam) {
            overlayGradCam.classList.remove('hidden');
          } else if (layer === 'vessel' && overlayVessel) {
            overlayVessel.classList.remove('hidden');
          }
        });
      });

      // Export Buttons
      const btnExport = document.getElementById('btn-export-quick');
      const btnPdf = document.getElementById('btn-dl-pdf');
      const printSummary = document.getElementById('btn-print-summary');
      const sendPacs = document.getElementById('btn-send-pacs');

      if (btnExport) btnExport.addEventListener('click', () => window.print());
      if (printSummary) printSummary.addEventListener('click', () => window.print());
      if (btnPdf) {
        btnPdf.addEventListener('click', () => {
          showToast('Generating verified PDF cryptographic bundle with DICOM metadata...', 'success');
        });
      }
      if (sendPacs) {
        sendPacs.addEventListener('click', () => {
          showToast('Transmitted DICOM Structured Report (SR) to PACS-STATION-04 [AET: FUNDUS_AI_01]', 'success');
        });
      }
    })();
  </script>
</body></html>