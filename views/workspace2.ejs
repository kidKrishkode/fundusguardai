<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary-container text-[24px]">dataset</span>
<div>
<h4 class="font-title-md text-title-md themed-text-primary font-semibold">Ongoing Queue: Ophthalmology Outpatient Clinic A</h4>
<p class="font-body-sm text-body-sm themed-text-muted">4 pending triage scans • Auto-flagged high priority: 2 cases</p>
</div>
</div>
<div class="flex items-center gap-space-sm">
<a class="px-space-md py-2 rounded-lg themed-card-low hover:themed-card-high themed-text-primary border themed-border-subtle font-label-md text-label-md flex items-center gap-1 transition-all font-semibold" href="batch-analysis.html">
