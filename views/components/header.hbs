<header
    class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.4)] border-b border-border-amber-glow">
    <div class="h-16 w-full px-margin md:px-margin-desktop flex items-center justify-between">
        <div class="flex items-center gap-space-md"><a class="flex items-center gap-space-sm" data-path="home" onclick="#">

                {{#if isHosted}}
                    <img alt="FundusGuard SPI-OWL Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1VSyKMAnqEMpF0Qp41pxQyfibMZGuYuGC1-neijErVixhMMNGHc2k0uFP92XIiRexAa8BUUjNRCESXBLRJJi5nY6are5QYEHBMbmfNTUwxuwrIUTD7kuresYzGGaJyg-VBfY7wHb-jWRk8aFvmpRtRjV9Kilw_qdr0PCeaihzpstYvX1FZRupMlonh0xUGvbMdvTUz93Ux9KA-RJkAG4laCIhipAmKxJFDLsyB3AROzKeeGBNQ8g5NggGQ" />
                {{else}}
                    <img src="../public/favicon.ico" class="h-8 w-auto object-contain" alt="FundusGuard SPI-OWL Logo" />
                {{/if}}

                <div class="flex flex-col">
                    <div class="flex items-center gap-space-xs"><span
                            class="font-headline-md text-headline-md tracking-tight text-text-primary">FundusGuard</span><span
                            class="font-headline-md text-headline-md tracking-tight text-optic-disc-gold">AI</span>
                    </div><span
                        class="font-label-sm text-label-sm text-text-secondary tracking-widest uppercase">Retinal
                        Diagnostics</span>
                </div>
            </a><span
                class="hidden lg:inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm border border-border-amber-glow"><span
                    class="w-1.5 h-1.5 rounded-full bg-status-healthy"></span>v1.0 SPI-OWL</span></div>
        <nav class="hidden xl:flex items-center gap-space-md"
            data-active-classes="text-on-primary-container bg-primary-container font-headline-md rounded-xl"><a
                aria-current="page"
                class="px-3 py-1.5 transition-colors text-on-primary-container bg-primary-container font-headline-md rounded-xl"
                data-path="home" onclick="route('/');">Home</a><a
                class="px-3 py-1.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="workspace" onclick="route('/workspace');">Workspace</a><a
                class="px-3 py-1.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="about" onclick="route('/about');">About</a><a
                class="px-3 py-1.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="api-docs" onclick="route('/api_plugin');">API Docs</a><a
                class="px-3 py-1.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="app-download" onclick="route('/app');">App Download</a><a
                class="px-3 py-1.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="contact" onclick="route('/contact');">Contact</a></nav>
        <div class="flex items-center gap-space-sm"><a
                class="hidden sm:inline-flex items-center gap-space-xs px-4 py-2 rounded-xl bg-gradient-to-r from-primary-container to-secondary-container font-label-md text-label-md text-on-primary font-bold shadow-[0_0_16px_rgba(234,88,12,0.35)] hover:shadow-[0_0_24px_rgba(234,88,12,0.55)] transition-all"
                data-path="workspace" onclick="route('/workspace');"><span>Launch Workspace</span><span
                    class="material-symbols-outlined text-[16px]">arrow_forward</span></a>
            <div class="flex items-center gap-space-xs pl-space-xs border-l border-border-subtle">
                <div class="relative group">
                    {{#if isHosted}}
                        <img alt="Profile" class="w-8 h-8 rounded-full object-cover ring-1 ring-border-amber-glow"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuC9zi90r8QK0ze7ooA9xiA1I33VFwwk42Q68WHYGPljBAgAxyUe-orHwwUIINc14GmDxQhHsZF1lLpdcINBvJEZHWaw9Bj_3FmXP_xnIcrd88w6hlYDYbcG8LkPCnx8N83PHkmoHMejZppORT51thoP4jgMCjb5MCQY3nvthjGlskgcdODRh_8aR05Ud5tEPSlFBuP6oZ3zvRbVDVs-a3QSRkazLn-eOhUC2O5yk9In2TQBu1YA9D61" />
                    {{else}}
                        <img src="../assets/images/dp.jpg" class="w-8 h-8 rounded-full object-cover ring-1 ring-border-amber-glow" alt="User Dp" />
                    {{/if}}
                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-status-healthy ring-2 ring-surface"></span>
                </div><button aria-label="Toggle mobile menu"
                    class="xl:hidden p-2 rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                    id="mobile-nav-toggle"><span class="material-symbols-outlined">menu</span></button>
            </div>
        </div>
    </div>
    <div class="hidden xl:hidden bg-surface-container-low border-b border-border-amber-glow px-margin py-space-md"
        id="mobile-drawer">
        <div class="flex flex-col gap-space-sm">
            <div class="flex items-center justify-between pb-space-sm border-b border-border-subtle"><span
                    class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1.5"><span
                        class="w-2 h-2 rounded-full bg-status-healthy animate-pulse"></span>Neural Telemetry: Live
                    (42ms)</span><span class="font-label-sm text-label-sm text-optic-disc-gold">SPI-OWL v1.0</span>
            </div><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="home" onclick="route('/');">Home</a><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="workspace" onclick="route('/workspace');">Workspace</a><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="about" onclick="route('/about');">About</a><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="api-docs" onclick="route('/api_plugin');">API Docs</a><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="app-download" onclick="route('/app');">App Download</a><a
                class="px-3 py-2 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors"
                data-path="contact" onclick="route('/contact');">Contact</a>
            <div class="pt-space-xs"><a
                    class="w-full flex items-center justify-center gap-space-xs px-4 py-2.5 rounded-xl bg-gradient-to-r from-primary-container to-secondary-container font-label-md text-label-md text-on-primary font-bold shadow-[0_0_16px_rgba(234,88,12,0.35)]"
                    data-path="workspace" onclick="route('/workspace');"><span>Launch Diagnostic Studio</span><span
                        class="material-symbols-outlined text-[16px]">biotech</span></a></div>
        </div>
    </div>
</header>