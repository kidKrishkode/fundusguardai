<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title version="1.0">FundusGuard AI — Developer Console & Analytics Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../public/App.css"/>
  <% if (isHosted) { %>
    <link rel="stylesheet" href="https://kidkrishkode.github.io/fundusguardai/assets/styles/dashboard.css"/>
  <% } else { %>
    <link rel="stylesheet" href="../assets/styles/dashboard.css" />
  <% } %>
</head>
<body>
  <div class="app-container">
    
    <!-- LEFT SIDEBAR NAVIGATION -->
    <aside class="sidebar" id="sidebar">
      <div>
        <!-- Brand Header -->
        <div class="brand-header">
          <div class="brand-logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <circle cx="12" cy="12" r="3.5" fill="currentColor"></circle>
              <path d="M12 3v2"></path>
              <path d="M12 19v2"></path>
              <path d="M3 12h2"></path>
              <path d="M19 12h2"></path>
            </svg>
          </div>
          <div class="brand-meta">
            <div class="brand-title">FundusGuard <span>AI</span></div>
            <div class="brand-badge">SPI-OWL v1.0 Console</div>
          </div>
        </div>

        <!-- Main Navigation Links -->
        <div class="nav-group-label">Core Dashboard</div>
        <ul class="nav-list">
          <li>
            <button class="nav-item-btn active" data-tab="overview">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="9"></rect>
                <rect x="14" y="3" width="7" height="5"></rect>
                <rect x="14" y="12" width="7" height="9"></rect>
                <rect x="3" y="16" width="7" height="5"></rect>
              </svg>
              <span>Overview</span>
            </button>
          </li>
          <li>
            <button class="nav-item-btn" data-tab="keys">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="8" cy="15" r="4"></circle>
                <path d="m10.85 12.15 7.65-7.65"></path>
                <path d="m15.5 7.5 2.5 2.5"></path>
                <path d="m14 9 2 2"></path>
              </svg>
              <span>Key Management</span>
              <span class="nav-badge-pill">1 Active</span>
            </button>
          </li>
          <li>
            <button class="nav-item-btn" data-tab="analytics">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3v18h18"></path>
                <path d="m19 9-5 5-4-4-5 5"></path>
              </svg>
              <span>Usage & Analytics</span>
            </button>
          </li>
          <li>
            <button class="nav-item-btn" data-tab="audit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Audit Trail</span>
            </button>
          </li>
          <li>
            <button class="nav-item-btn" data-tab="billing">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
              <span>Billings & Quota</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Bottom Pinned Section -->
      <div class="sidebar-footer">
        <!-- Theme Toggle -->
        <div class="theme-toggle-row">
          <div class="theme-label">
            <svg id="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span id="theme-text">Dark Mode</span>
          </div>
          <button class="theme-switch-btn" id="theme-toggle-btn" aria-label="Toggle dark/light mode"></button>
        </div>

        <ul class="nav-list">
          <li>
            <button class="nav-item-btn" data-tab="settings">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <span>Settings</span>
            </button>
          </li>
        </ul>

        <!-- Account Profile Strip -->
        <a href="javascript:void(0)" class="user-profile-strip" onclick="switchTab('account')">
          <div class="avatar-circle">KM</div>
          <div class="user-info-text">
            <span class="user-name">Krishnendu Mitra</span>
            <span class="user-role">Lead Developer</span>
          </div>
        </a>

        <!-- Log Out Link -->
        <a  onclick="route('/index');" class="nav-item-btn" style="color: var(--danger); margin-top: 4px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Log Out</span>
        </a>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT VIEW -->
    <main class="main-viewport">
      <!-- Top Sticky Bar -->
      <header class="topbar">
        <div class="topbar-left">
          <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Open sidebar menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="breadcrumb-trail">
            <span>FundusGuard AI</span>
            <span>/</span>
            <span class="current-tab-crumb" id="breadcrumb-current">Overview</span>
          </div>
        </div>

        <div class="topbar-right">
          <div class="status-pill">
            <span class="status-dot-pulse"></span>
            <span>API Cluster Operational</span>
          </div>
          <a onclick="route('/docs');" class="nav-doc-link" target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span>API Docs</span>
          </a>
        </div>
      </header>

      <!-- Content Area with Active Views -->
      <div class="content-area">
        
        <!-- 1. OVERVIEW VIEW (DEFAULT ACTIVE) -->
        <section class="tab-panel active" id="view-overview">
          <div class="view-header">
            <div class="view-title-wrap">
              <h1>Welcome back, Developer 👋</h1>
              <p>Real-time telemetry, API usage quota, and SPI-OWL neural inference health metrics.</p>
            </div>
            <div class="view-actions">
              <button class="btn btn-secondary" onclick="switchTab('keys')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="8" cy="15" r="4"></circle>
                  <path d="m10.85 12.15 7.65-7.65"></path>
                </svg>
                <span>Manage Keys</span>
              </button>
              <button class="btn btn-primary" onclick="openKeyModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Generate Key</span>
              </button>
            </div>
          </div>

          <!-- Quick Stats 4 Cards Grid -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-top">
                <span class="stat-label">Total Monthly Requests</span>
                <div class="stat-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                </div>
              </div>
              <div class="stat-value">420 <span style="font-size: 0.95rem; color: var(--text-muted); font-weight: 500;">/ 1,000</span></div>
              <div class="stat-sub positive">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg>
                <span>42% Quota Consumed</span>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-top">
                <span class="stat-label">Avg Inference Latency</span>
                <div class="stat-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
              </div>
              <div class="stat-value">1.85s</div>
              <div class="stat-sub positive">
                <span>⚡ Sub-2.5s SLA Maintained</span>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-top">
                <span class="stat-label">Inference Success Rate</span>
                <div class="stat-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
              </div>
              <div class="stat-value">99.4%</div>
              <div class="stat-sub positive">
                <span>0.6% Client Validation Faults</span>
              </div>
            </div>

            <div class="stat-card">
              <div class="stat-top">
                <span class="stat-label">Active API Keys</span>
                <div class="stat-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="15" r="4"/><path d="m10.85 12.15 7.65-7.65"/></svg>
                </div>
              </div>
              <div class="stat-value">1 Active</div>
              <div class="stat-sub">
                <span>Primary Production Token</span>
              </div>
            </div>
          </div>

          <!-- Active Key Summary Strip -->
          <div class="card" style="margin-bottom: 24px;">
            <div class="card-header-line" style="margin-bottom: 12px;">
              <div>
                <div class="card-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="15" r="4"/><path d="m10.85 12.15 7.65-7.65"/></svg>
                  <span>Active Production API Key</span>
                </div>
                <div class="card-subtitle">Use this key in the <code>X-Fundus-API-Key</code> request header for edge fundus diagnostics.</div>
              </div>
              <button class="btn btn-secondary" onclick="switchTab('keys')" style="padding: 6px 14px; font-size: 0.8rem;">
                <span>View All Keys →</span>
              </button>
            </div>
            <div class="key-highlight-strip">
              <div style="display: flex; align-items: center; gap: 12px;">
                <span class="badge-status active">Live & Authenticated</span>
                <span class="key-token-code" id="overview-masked-key">fg_live_••••••••19d</span>
              </div>
              <div style="display: flex; gap: 8px;">
                <button class="copy-btn" onclick="copyApiKey('fg_live_99f3a817b204e19d')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <span>Copy Key</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Graphical Grid: Traffic Chart & Calendar -->
          <div class="grid-2col">
            <!-- Monthly Traffic Bar Chart -->
            <div class="card">
              <div class="card-header-line">
                <div>
                  <div class="card-title">Monthly Inference Request Volume</div>
                  <div class="card-subtitle">Aggregated daily requests processed across SPI-OWL v1.0</div>
                </div>
                <span class="badge-status active">March 2025</span>
              </div>
              <div class="chart-box">
                <!-- SVG Vector Bar Graphic -->
                <svg viewBox="0 0 600 200" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="barGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#ea580c" />
                      <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.2" />
                    </linearGradient>
                    <linearGradient id="activeBarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#f59e0b" />
                      <stop offset="100%" stop-color="#ea580c" />
                    </linearGradient>
                  </defs>
                  <!-- Grid horizontal lines -->
                  <line x1="0" y1="40" x2="600" y2="40" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                  <line x1="0" y1="90" x2="600" y2="90" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                  <line x1="0" y1="140" x2="600" y2="140" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4" />
                  <line x1="0" y1="180" x2="600" y2="180" stroke="rgba(255,255,255,0.15)" />

                  <!-- Daily Bars -->
                  <rect x="25" y="130" width="16" height="50" rx="3" fill="url(#barGrad)" />
                  <rect x="65" y="110" width="16" height="70" rx="3" fill="url(#barGrad)" />
                  <rect x="105" y="80" width="16" height="100" rx="3" fill="url(#barGrad)" />
                  <rect x="145" y="95" width="16" height="85" rx="3" fill="url(#barGrad)" />
                  <rect x="185" y="60" width="16" height="120" rx="3" fill="url(#barGrad)" />
                  <rect x="225" y="70" width="16" height="110" rx="3" fill="url(#barGrad)" />
                  <rect x="265" y="50" width="16" height="130" rx="3" fill="url(#barGrad)" />
                  <rect x="305" y="90" width="16" height="90" rx="3" fill="url(#barGrad)" />
                  <rect x="345" y="45" width="16" height="135" rx="3" fill="url(#barGrad)" />
                  <rect x="385" y="40" width="16" height="140" rx="3" fill="url(#barGrad)" />
                  <rect x="425" y="30" width="16" height="150" rx="3" fill="url(#activeBarGrad)" filter="drop-shadow(0 0 8px rgba(234, 88, 12, 0.4))" />
                  <rect x="465" y="65" width="16" height="115" rx="3" fill="url(#barGrad)" />
                  <rect x="505" y="85" width="16" height="95" rx="3" fill="url(#barGrad)" />
                  <rect x="545" y="120" width="16" height="60" rx="3" fill="url(#barGrad)" />
                </svg>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-top: 8px;">
                <span>Mar 1</span>
                <span>Mar 5</span>
                <span>Mar 10</span>
                <span>Mar 15 (Peak)</span>
                <span>Mar 20</span>
                <span>Mar 25</span>
                <span>Today</span>
              </div>
            </div>

            <!-- Calendar & Billing Cycle -->
            <div class="card calendar-container">
              <div class="calendar-header">
                <div>
                  <div class="cal-month-title">Billing Calendar</div>
                  <div class="card-subtitle">Next Cycle: April 1, 2025</div>
                </div>
                <span class="badge-status success">Current Month: Paid ($0.00)</span>
              </div>
              <div class="cal-grid">
                <div class="cal-day-label">S</div>
                <div class="cal-day-label">M</div>
                <div class="cal-day-label">T</div>
                <div class="cal-day-label">W</div>
                <div class="cal-day-label">T</div>
                <div class="cal-day-label">F</div>
                <div class="cal-day-label">S</div>

                <!-- March 2025 sample days -->
                <div class="cal-day-cell muted-day">23</div>
                <div class="cal-day-cell muted-day">24</div>
                <div class="cal-day-cell muted-day">25</div>
                <div class="cal-day-cell muted-day">26</div>
                <div class="cal-day-cell muted-day">27</div>
                <div class="cal-day-cell muted-day">28</div>
                <div class="cal-day-cell">1</div>

                <div class="cal-day-cell">2</div>
                <div class="cal-day-cell">3</div>
                <div class="cal-day-cell">4</div>
                <div class="cal-day-cell">5</div>
                <div class="cal-day-cell">6</div>
                <div class="cal-day-cell">7</div>
                <div class="cal-day-cell">8</div>

                <div class="cal-day-cell">9</div>
                <div class="cal-day-cell">10</div>
                <div class="cal-day-cell">11</div>
                <div class="cal-day-cell">12</div>
                <div class="cal-day-cell">13</div>
                <div class="cal-day-cell">14</div>
                <div class="cal-day-cell">15</div>

                <div class="cal-day-cell">16</div>
                <div class="cal-day-cell">17</div>
                <div class="cal-day-cell">18</div>
                <div class="cal-day-cell active-day" title="Today">19</div>
                <div class="cal-day-cell">20</div>
                <div class="cal-day-cell">21</div>
                <div class="cal-day-cell">22</div>

                <div class="cal-day-cell">23</div>
                <div class="cal-day-cell">24</div>
                <div class="cal-day-cell">25</div>
                <div class="cal-day-cell">26</div>
                <div class="cal-day-cell">27</div>
                <div class="cal-day-cell">28</div>
                <div class="cal-day-cell">29</div>

                <div class="cal-day-cell">30</div>
                <div class="cal-day-cell">31</div>
                <div class="cal-day-cell bill-day" title="Next Bill Date: Quota Reset">1</div>
              </div>

              <div class="bill-reminder-badge">
                <div class="bill-reminder-text">
                  📅 Next Quota Reset in <strong>12 days</strong>
                </div>
                <span class="bill-status-pill">Active Plan</span>
              </div>
            </div>
          </div>

          <!-- Uptime Grant / Timeline Chart -->
          <div class="card" style="margin-bottom: 24px;">
            <div class="card-header-line">
              <div>
                <div class="card-title">System & API Key SLA Uptime (Last 30 Days)</div>
                <div class="card-subtitle">99.98% overall availability across inference worker nodes</div>
              </div>
              <span class="badge-status success">100% Operational Today</span>
            </div>

            <div class="uptime-gantt-strip">
              <div class="gantt-bars-row">
                <!-- 30 Gantt bar segments -->
                <div class="gantt-bar-slice" title="Day 1: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 2: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 3: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 4: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 5: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 6: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 7: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 8: 100% uptime"></div>
                <div class="gantt-bar-slice warn" title="Day 9: 99.2% uptime (Routine maintenance)"></div>
                <div class="gantt-bar-slice" title="Day 10: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 11: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 12: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 13: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 14: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 15: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 16: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 17: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 18: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 19: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 20: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 21: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 22: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 23: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 24: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 25: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 26: 100% uptime"></div>
                <div class="gantt-bar-slice" title="Day 27: 100% uptime"></div>
