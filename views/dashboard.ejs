        <input type="text" id="modal-key-name" class="form-input" placeholder="e.g. Staging Test Environment" value="Staging Test Environment">
        <div class="form-hint">A friendly identifier to help you track where this token is integrated.</div>
      </div>

      <div class="form-group">
        <label class="form-label">Scope & Permissions</label>
        <select class="form-input" style="cursor: pointer;">
          <option>Full Inference & Segmentation (/api/v1/*)</option>
          <option>Read-Only Telemetry (/api/v1/health)</option>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px;">
        <button class="btn btn-secondary" onclick="closeKeyModal()">Cancel</button>
        <button class="btn btn-primary" onclick="generateNewKeyAction()">
          <span>Create 256-Bit Token</span>
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST CONTAINER -->
  <div class="toast-container">
    <div class="toast" id="app-toast">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span id="toast-message">Notification</span>
    </div>
  </div>

</body>
<script src="../public/App.js" nonce="<%= nonce %>" ></script>
<% if (isHosted) { %>
  <script src="https://kidkrishkode.github.io/fundusguardai/assets/scripts/dashboard.js" nonce="<%= nonce %>"></script>
<% } else { %>
  <script src="../assets/scripts/dashboard.js" nonce="<%= nonce %>"></script>
<% } %>
</html>