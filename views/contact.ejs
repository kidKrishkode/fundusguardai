<!DOCTYPE html>

<html class="dark" lang="en"
  style="overflow-y: auto !important; overflow-x: hidden; height: auto !important; min-height: 100vh; position: static !important; scroll-behavior: smooth;">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  
  <link rel="stylesheet" href="../assets/styles/App.css"/>
  <link rel="stylesheet" href="../assets/styles/contact.css"/>
  
  <script src="../assets/scripts/App.js"></script>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="../assets/scripts/tailwind.js"></script>
  
</head>

<body
  class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary"
  style="overflow-y: auto !important; overflow-x: hidden; height: auto !important; min-height: 100vh; position: static !important;">
  <%- header %>
  <main class="w-full pt-16 bg-surface" style="position: static !important; overflow: visible;">
    <div class="flex flex-col w-full text-on-surface">
      <!-- Subtle Ambient Glow Canvas Backdrop -->
      <div class="relative w-full overflow-hidden bg-surface-container-lowest">
        <div
          class="absolute -top-32 right-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none">
        </div>
        <div class="absolute top-1/3 -left-32 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"></div>
        <!-- Header / Editorial Masthead Section -->
        <section class="relative w-full px-margin md:px-margin-desktop pt-10 pb-12">
          <div class="max-w-7xl mx-auto flex flex-col gap-space-md">
            <!-- Breadcrumb & Status Indicator -->
            <div class="flex flex-wrap items-center gap-space-sm text-text-secondary">
              <span
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm">
                <span class="w-2 h-2 rounded-full bg-status-healthy"></span>
                Academic &amp; Clinical Liaison Office
              </span>
              <span class="text-text-secondary font-label-sm text-label-sm">/</span>
              <span class="text-optic-disc-gold font-label-sm text-label-sm">Institutional Inquiry Desk</span>
              <span class="hidden md:inline-block text-text-secondary font-label-sm text-label-sm">• Average response:
                1–2 research days</span>
            </div>
            <!-- Section Title & Subheading -->
            <div class="flex flex-col gap-space-xs max-w-4xl">
              <h1 class="font-headline-xl text-headline-xl text-text-primary tracking-tight">
                Connect with the Clinical Research &amp; Development Team
              </h1>
              <p class="font-body-lg text-body-lg text-text-secondary leading-relaxed pt-1">
                Whether you represent an eye clinic, an academic medical center evaluating retrospective cohorts, a
                hospital network preparing IRB validation protocols, or an independent ophthalmologist reviewing SPI-OWL
                algorithmic outputs — we welcome peer dialogue, structured trial collaboration, and technical
                integration questions.
              </p>
            </div>
            <!-- Category Channel Pills (Fast Access) -->
            <div class="flex flex-wrap gap-space-xs pt-space-xs">
              <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors"
                data-select-track="trial" href="#inquiry-form">
                <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">clinical_notes</span>
                <span>Clinical Trial Partnerships</span>
              </a>
              <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors"
                data-select-track="irb" href="#inquiry-form">
                <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">policy</span>
                <span>IRB Protocol Standardisation</span>
              </a>
              <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors"
                data-select-track="pacs" href="#inquiry-form">
                <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">storage</span>
                <span>PACS / DICOM Pipeline Support</span>
              </a>
              <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors"
                href="#institutional-framework">
                <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">menu_book</span>
                <span>Academic Citations &amp; Code Repository</span>
              </a>
            </div>
          </div>
        </section>
        <!-- Main Section: 2-Column Split -->
        <section class="w-full px-margin md:px-margin-desktop pb-16">
          <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
            <!-- LEFT COLUMN: Structured Multi-Track Inquiry Form (7 Columns) -->
            <div class="lg:col-span-7 flex flex-col gap-space-md" id="inquiry-form">
              <div class="bg-surface-container-low rounded-xl p-space-lg shadow-xl relative overflow-hidden">
                <!-- Subtle gradient beam decorative rim -->
                <div
                  class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-primary-container via-optic-disc-gold to-transparent opacity-80">
                </div>
                <div class="flex flex-col gap-space-xs pb-space-md">
                  <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-optic-disc-gold uppercase tracking-wider">Protocol
                      Form FG-702</span>
                    <span class="font-label-sm text-label-sm text-text-secondary flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px] text-status-healthy">shield</span>
                      256-Bit TLS Research Ingestion
                    </span>
                  </div>
                  <h2 class="font-headline-md text-headline-md text-text-primary">Clinical &amp; Technical Inquiry
                    Portal</h2>
                  <p class="font-body-sm text-body-sm text-text-secondary">
                    Please select your inquiry category below to route details directly to the relevant primary
                    researcher or integration engineer.
                  </p>
                </div>
                <!-- Inquiry Track Selector Tabs -->
                <div class="flex flex-wrap gap-1 p-1 bg-surface-container rounded-lg mb-space-md" id="track-selector">
                  <button
                    class="track-btn flex-1 min-w-[140px] px-3 py-2 rounded-md font-label-sm text-label-sm text-center transition-all bg-primary-container text-on-primary font-semibold shadow-sm"
                    data-track="trial" type="button">
                    Clinical Trial &amp; Hospital
                  </button>
                  <button
                    class="track-btn flex-1 min-w-[140px] px-3 py-2 rounded-md font-label-sm text-label-sm text-center transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-bright"
                    data-track="feedback" type="button">
                    Ophthalmologist Feedback
                  </button>
                  <button
                    class="track-btn flex-1 min-w-[140px] px-3 py-2 rounded-md font-label-sm text-label-sm text-center transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-bright"
                    data-track="academic" type="button">
                    Academic &amp; Research
                  </button>
                  <button
                    class="track-btn flex-1 min-w-[140px] px-3 py-2 rounded-md font-label-sm text-label-sm text-center transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-bright"
                    data-track="pacs" type="button">
                    Technical / PACS API
                  </button>
                </div>
                <!-- Submission Form -->
                <form class="flex flex-col gap-space-md" id="clinicalInquiryForm" onsubmit="return false;">
                  <!-- Hidden input to store chosen track -->
                  <input id="selectedTrackInput" name="inquiryTrack" type="hidden"
                    value="Clinical Trial &amp; Hospital Partner" />
                  <!-- Name & Academic Title -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                      <label class="font-label-md text-label-md text-on-surface" for="fullName">
                        Full Name &amp; Academic Credentials <span class="text-primary-container">*</span>
                      </label>
                      <input
                        class="w-full h-10 px-3 rounded-lg bg-surface-container text-text-primary placeholder:text-text-secondary text-body-sm font-body-sm focus:outline-none focus:bg-surface-container-high focus:shadow-[0_0_0_2px_rgba(246,96,24,0.4)] transition-all"
                        id="fullName" placeholder="e.g., Sarah Jenkins, MD, FRCOphth" required="" type="text" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="font-label-md text-label-md text-on-surface" for="institution">
                        Institutional Affiliation <span class="text-primary-container">*</span>
                      </label>
                      <input
                        class="w-full h-10 px-3 rounded-lg bg-surface-container text-text-primary placeholder:text-text-secondary text-body-sm font-body-sm focus:outline-none focus:bg-surface-container-high focus:shadow-[0_0_0_2px_rgba(246,96,24,0.4)] transition-all"
                        id="institution" placeholder="e.g., St. Jude Eye Hospital / University Dept." required=""
                        type="text" />
                    </div>
                  </div>
                  <!-- Email & Role/Specialty Dropdown -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                      <label class="font-label-md text-label-md text-on-surface" for="workEmail">
                        Professional / Institutional Email <span class="text-primary-container">*</span>
                      </label>
                      <input
                        class="w-full h-10 px-3 rounded-lg bg-surface-container text-text-primary placeholder:text-text-secondary text-body-sm font-body-sm focus:outline-none focus:bg-surface-container-high focus:shadow-[0_0_0_2px_rgba(246,96,24,0.4)] transition-all"
                        id="workEmail" placeholder="name@institution.edu or clinic.org" required="" type="email" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                      <label class="font-label-md text-label-md text-on-surface" for="specialtyRole">
                        Clinical Role / Specialty <span class="text-primary-container">*</span>
                      </label>
                      <div class="relative">
                        <select
                          class="w-full h-10 pl-3 pr-8 rounded-lg bg-surface-container text-text-primary text-body-sm font-body-sm appearance-none focus:outline-none focus:bg-surface-container-high focus:shadow-[0_0_0_2px_rgba(246,96,24,0.4)] transition-all cursor-pointer"
                          id="specialtyRole" required="">
                          <option disabled="" selected="" value="">Select clinical or technical role</option>
                          <option value="glaucoma_specialist">Glaucoma Subspecialist / Consultant</option>
                          <option value="general_ophthalmologist">General Ophthalmologist</option>
                          <option value="optometrist">Optometrist / Ophthalmic Clinician</option>
                          <option value="trial_coordinator">Clinical Trial Coordinator / Research Fellow</option>
                          <option value="biomedical_engineer">Biomedical Engineer / Medical Physicist</option>
                          <option value="pacs_admin">Hospital IT / PACS Administrator</option>
                          <option value="academic_faculty">University Faculty / Postdoctoral Researcher</option>
                          <option value="other">Other Healthcare Professional</option>
                        </select>
                        <span
                          class="material-symbols-outlined text-[18px] text-text-secondary absolute right-2.5 top-2.5 pointer-events-none">expand_more</span>
                      </div>
                    </div>
                  </div>
                  <!-- Scope & Primary Topics (Multi-choice pills) -->
                  <div class="flex flex-col gap-1.5 pt-1">
                    <label class="font-label-md text-label-md text-on-surface">Primary Areas of Interest (Select
                      applicable)</label>
                    <div class="flex flex-wrap gap-2 pt-1" id="interestTags">
                      <label class="cursor-pointer">
                        <input class="peer sr-only" name="interest" type="checkbox" value="Edge_Inference" />
                        <span
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container peer-checked:bg-primary-container peer-checked:text-on-primary text-text-secondary text-label-md font-label-md transition-all select-none hover:bg-surface-container-high">
                          <span class="material-symbols-outlined text-[14px]">memory</span>
                          Local Offline Edge Node
                        </span>
                      </label>
                      <label class="cursor-pointer">
                        <input class="peer sr-only" name="interest" type="checkbox" value="Retrospective_Cohort" />
                        <span
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container peer-checked:bg-primary-container peer-checked:text-on-primary text-text-secondary text-label-md font-label-md transition-all select-none hover:bg-surface-container-high">
                          <span class="material-symbols-outlined text-[14px]">dataset</span>
                          Retrospective Cohort Testing
                        </span>
                      </label>
                      <label class="cursor-pointer">
                        <input class="peer sr-only" name="interest" type="checkbox" value="DICOM_PACS" />
                        <span
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container peer-checked:bg-primary-container peer-checked:text-on-primary text-text-secondary text-label-md font-label-md transition-all select-none hover:bg-surface-container-high">
                          <span class="material-symbols-outlined text-[14px]">device_hub</span>
                          DICOM PACS Bridge
                        </span>
                      </label>
                      <label class="cursor-pointer">
                        <input class="peer sr-only" name="interest" type="checkbox" value="Paper_Discussion" />
                        <span
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container peer-checked:bg-primary-container peer-checked:text-on-primary text-text-secondary text-label-md font-label-md transition-all select-none hover:bg-surface-container-high">
                          <span class="material-symbols-outlined text-[14px]">article</span>
                          SPI-OWL Architecture Paper
                        </span>
                      </label>
                      <label class="cursor-pointer">
                        <input class="peer sr-only" name="interest" type="checkbox" value="Prototype_Access" />
                        <span
                          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container peer-checked:bg-primary-container peer-checked:text-on-primary text-text-secondary text-label-md font-label-md transition-all select-none hover:bg-surface-container-high">
                          <span class="material-symbols-outlined text-[14px]">biotech</span>
                          Research Workspace Demo
                        </span>
                      </label>
                    </div>
                  </div>
                  <!-- Message Textarea -->
                  <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface" for="clinicalMessage">
                      Inquiry Scope &amp; Equipment Context <span class="text-primary-container">*</span>
                    </label>
                    <textarea
                      class="w-full p-3 rounded-lg bg-surface-container text-text-primary placeholder:text-text-secondary text-body-sm font-body-sm focus:outline-none focus:bg-surface-container-high focus:shadow-[0_0_0_2px_rgba(246,96,24,0.4)] transition-all resize-y"
                      id="clinicalMessage"
                      placeholder="Describe your clinical setting, equipment models in use (e.g., Topcon TRC-NW400, Zeiss Clarus 500, Canon CR-2), patient cohort scale, or specific algorithmic questions..."
                      required="" rows="4"></textarea>
                  </div>
                  <!-- Research Ethics & Data Confidentiality Consent -->
                  <div class="flex items-start gap-2.5 pt-1">
                    <input
                      class="mt-1 w-4 h-4 rounded bg-surface-container border-0 text-primary-container focus:ring-0 focus:outline-none cursor-pointer"
                      id="researchConsent" required="" type="checkbox" />
                    <label class="font-body-sm text-body-sm text-text-secondary select-none leading-relaxed"
                      for="researchConsent">
                      I understand that <strong class="text-on-surface">FundusGuard AI</strong> is an investigational
                      clinical decision-support research project. I consent to technical correspondence and confirm that
                      any sample data transmitted adheres to applicable institutional patient privacy and
                      de-identification regulations.
                    </label>
                  </div>
                  <!-- Form Action Buttons -->
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-space-sm pt-space-xs">
                    <button
                      class="w-full sm:w-auto px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-text-secondary hover:text-on-surface font-label-md text-label-md transition-colors flex items-center justify-center gap-1.5"
                      id="resetBtn" type="button">
                      <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                      <span>Clear Fields</span>
                    </button>
                    <button
                      class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-gradient-to-r from-primary-container to-secondary-container text-on-primary font-headline-md text-headline-md tracking-normal hover:shadow-[0_0_20px_rgba(246,96,24,0.45)] transition-all flex items-center justify-center gap-2"
                      id="submitBtn" type="submit">
                      <span id="submitText">Submit Clinical Inquiry</span>
                      <span class="material-symbols-outlined text-[18px]">send</span>
                    </button>
                  </div>
                </form>
                <!-- Dynamic Confirmation Card (Hidden by Default) -->
                <div
                  class="hidden mt-space-md p-space-lg rounded-xl bg-surface-container border-l-4 border-l-status-healthy flex flex-col gap-space-sm animate-fadeIn"
                  id="confirmationNotice">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-status-healthy text-[24px]">verified</span>
                    <h3 class="font-title-md text-title-md text-text-primary">Clinical Inquiry Received</h3>
                  </div>
                  <p class="font-body-sm text-body-sm text-text-secondary leading-relaxed">
                    Thank you. Your dossier has been logged under inquiry reference <span
                      class="font-mono text-optic-disc-gold font-semibold"
                      id="referenceCodeNumber">#FG-2025-0814</span>.
                    A confirmation has been queued for your institutional inbox. Our primary investigators review
                    academic requests systematically within 1–2 business days.
                  </p>
                  <div
                    class="flex flex-wrap items-center gap-space-md pt-2 text-label-sm font-label-sm text-text-secondary">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px] text-optic-disc-gold">schedule</span>
                      Response Queue: Priority Active
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px] text-status-healthy">mark_email_read</span>
                      Copy dispatched to sender
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <!-- RIGHT COLUMN: Bento-Style Institutional Framework & Governance (5 Columns) -->
            <div class="lg:col-span-5 flex flex-col gap-space-md" id="institutional-framework">
              <!-- Bento Card 1: Academic Leadership & Research Lab -->
              <div
                class="p-space-lg rounded-xl bg-surface-container-low shadow-lg flex flex-col gap-space-sm relative overflow-hidden">
                <div class="flex items-start justify-between">
                  <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-optic-disc-gold uppercase tracking-wider">Research
                      Headquarters</span>
                    <h3 class="font-title-md text-title-md text-text-primary">Department of CSE &amp; Biomedical Lab
                    </h3>
                  </div>
                  <div
                    class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-optic-disc-gold">
                    <span class="material-symbols-outlined">account_balance</span>
                  </div>
                </div>
                <p class="font-body-sm text-body-sm text-text-secondary leading-relaxed">
                  Developed under formal university research protocols focusing on computer vision applications in
                  non-invasive retinal biomicroscopy and cup-to-disc ratio (CDR) topography.
                </p>
                <div class="p-3 rounded-lg bg-surface-container flex flex-col gap-2">
                  <div class="flex items-center gap-2.5">
                    <div
                      class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary-container font-headline-md text-label-md">
                      KM
                    </div>
                    <div class="flex flex-col">
                      <span class="font-label-md text-label-md text-on-surface font-semibold">Krishnendu Mitra</span>
                      <span class="font-label-sm text-label-sm text-text-secondary">Lead System Architect &amp; Student
                        Developer</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2.5 pt-1 border-t border-surface-bright/40">
                    <div
                      class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-secondary font-headline-md text-label-md">
                      SM
                    </div>
                    <div class="flex flex-col">
                      <span class="font-label-md text-label-md text-on-surface font-semibold">Prof. Soumen
                        Mukherjee</span>
                      <span class="font-label-sm text-label-sm text-text-secondary">Research Faculty &amp; Academic
                        Supervisor</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center justify-between text-label-sm font-label-sm text-text-secondary pt-1">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-status-healthy"></span>
                    Review cycle: Mon–Fri
                  </span>
                  <span class="text-on-surface-variant font-medium">Kolkata / Global Inquiries</span>
                </div>
              </div>
              <!-- Bento Card 2: Institutional Collaboration Frameworks -->
              <div class="p-space-lg rounded-xl bg-surface-container-low shadow-lg flex flex-col gap-space-sm">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary-container text-[20px]">hub</span>
                  <h3 class="font-title-md text-title-md text-text-primary">Collaboration Frameworks</h3>
                </div>
                <div class="flex flex-col gap-2.5">
                  <div
                    class="p-3 rounded-lg bg-surface-container flex flex-col gap-1 hover:bg-surface-container-high transition-colors">
                    <div class="flex items-center justify-between">
                      <span class="font-label-md text-label-md text-on-surface font-semibold">1. Non-Commercial Academic
                        Access</span>
                      <span
                        class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-high text-optic-disc-gold">No
                        Cost</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-text-secondary">
                      Complete access to model weights and the SPI-OWL segmentation pipeline for accredited
                      ophthalmology residency programs and university research centers.
                    </p>
                  </div>
                  <div
                    class="p-3 rounded-lg bg-surface-container flex flex-col gap-1 hover:bg-surface-container-high transition-colors">
                    <div class="flex items-center justify-between">
                      <span class="font-label-md text-label-md text-on-surface font-semibold">2. Multi-Cohort Blinded
                        Validation</span>
                      <span
                        class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-high text-status-healthy">IRB
                        Ready</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-text-secondary">
                      Joint study designs for benchmarking cup-to-disc boundary precision against OCT (Optical Coherence
                      Tomography) RNFL ground truth across diverse demographics.
                    </p>
                  </div>
                  <div
                    class="p-3 rounded-lg bg-surface-container flex flex-col gap-1 hover:bg-surface-container-high transition-colors">
                    <div class="flex items-center justify-between">
                      <span class="font-label-md text-label-md text-on-surface font-semibold">3. Hardware
                        Interoperability Bench</span>
                      <span
                        class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-high text-on-surface-variant">OEM
                        Friendly</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-text-secondary">
                      Calibration protocols for non-mydriatic desktop fundus cameras and smartphone ophthalmoscope
                      attachments for rural community triage settings.
                    </p>
                  </div>
                </div>
              </div>
              <!-- Bento Card 3: Clinical Governance & Privacy Safeguards -->
              <div class="p-space-lg rounded-xl bg-surface-container-low shadow-lg flex flex-col gap-space-sm">
                <div class="flex items-center gap-2">
