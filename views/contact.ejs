<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <title>Contact &amp; Clinical Collaboration | FundusGuard AI</title>
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../public/App.css"/>
  <% if (isHosted) { %>
    <link rel="stylesheet" href="https://kidkrishkode.github.io/fundusguardai/assets/styles/contact.css"/>
  <% } else { %>
    <link rel="stylesheet" href="../assets/styles/contact.css" />
  <% } %>
</head>

<body>
  <%- header %>
  <main class="page-main">
    <div class="hero-canvas">
      <div class="glow-orb-primary"></div>
      <div class="glow-orb-secondary"></div>
      <!-- Header / Editorial Masthead Section -->
      <section class="masthead-section">
        <div class="container-max masthead-wrap">
          <!-- Section Title & Subheading -->
          <div style="display: flex; flex-direction: column; gap: 0.25rem; max-width: 56rem;">
            <h1 class="headline-main">
              Connect with the Clinical Research &amp; Development Team
            </h1>
            <p class="lead-desc">
              Whether you represent an eye clinic, an academic medical center evaluating retrospective cohorts, a
              hospital network preparing IRB validation protocols, or an independent ophthalmologist reviewing SPI-OWL
              algorithmic outputs — we welcome peer dialogue, structured trial collaboration, and technical integration
              questions.
            </p>
          </div>
          <!-- Category Channel Pills (Fast Access) -->
          <div class="pills-container">
            <a class="filter-pill" data-select-track="trial" href="#inquiry-form">
              <span class="material-symbols-outlined"
                style="font-size: 16px; color: var(--optic-disc-gold);">clinical_notes</span>
              <span>Clinical Trial Partnerships</span>
            </a>
            <a class="filter-pill" data-select-track="irb" href="#inquiry-form">
              <span class="material-symbols-outlined"
                style="font-size: 16px; color: var(--optic-disc-gold);">policy</span>
              <span>IRB Protocol Standardisation</span>
            </a>
            <a class="filter-pill" data-select-track="pacs" href="#inquiry-form">
              <span class="material-symbols-outlined"
                style="font-size: 16px; color: var(--optic-disc-gold);">storage</span>
              <span>PACS / DICOM Pipeline Support</span>
            </a>
            <a class="filter-pill" href="#institutional-framework">
              <span class="material-symbols-outlined"
                style="font-size: 16px; color: var(--optic-disc-gold);">menu_book</span>
              <span>Academic Citations &amp; Code Repository</span>
            </a>
          </div>
        </div>
      </section>
      <!-- Main Section: 2-Column Split -->
      <section class="content-section">
        <div class="container-max contact-grid">
          <!-- LEFT COLUMN: Structured Multi-Track Inquiry Form -->
          <div id="inquiry-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div class="form-card">
              <div class="card-beam-glow"></div>
              <div class="card-header-bar">
                <div class="protocol-meta">
                  <span class="protocol-id">Protocol Form FG-702</span>
                  <span class="protocol-security">
                    <span class="material-symbols-outlined"
                      style="font-size: 14px; color: var(--status-healthy);">shield</span>
                    256-Bit TLS Research Ingestion
                  </span>
                </div>
                <h2 class="form-title">Clinical &amp; Technical Inquiry Portal</h2>
                <p class="form-intro">
                  Please select your inquiry category below to route details directly to the relevant primary researcher
                  or integration engineer.
                </p>
              </div>
              <!-- Inquiry Track Selector Tabs -->
              <div class="track-tabs-container" id="track-selector">
                <button class="track-tab-btn active" data-track="trial" type="button">
                  Clinical Trial &amp; Hospital
                </button>
                <button class="track-tab-btn" data-track="feedback" type="button">
                  Ophthalmologist Feedback
                </button>
                <button class="track-tab-btn" data-track="academic" type="button">
                  Academic &amp; Research
                </button>
                <button class="track-tab-btn" data-track="pacs" type="button">
                  Technical / PACS API
                </button>
              </div>
              <!-- Submission Form -->
              <form class="clinical-form" id="clinicalInquiryForm" onsubmit="return false;">
                <input id="selectedTrackInput" name="inquiryTrack" type="hidden"
                  value="Clinical Trial &amp; Hospital Partner" />
                <!-- Name & Academic Title -->
                <div class="form-row-2col">
                  <div class="input-group">
                    <label class="input-label" for="fullName">
                      Full Name &amp; Academic Credentials <span class="req-star">*</span>
                    </label>
                    <input class="text-input" id="fullName" placeholder="e.g., Sarah Jenkins, MD, FRCOphth" required=""
                      type="text" />
                  </div>
                  <div class="input-group">
                    <label class="input-label" for="institution">
                      Institutional Affiliation <span class="req-star">*</span>
                    </label>
                    <input class="text-input" id="institution"
                      placeholder="e.g., St. Jude Eye Hospital / University Dept." required="" type="text" />
                  </div>
                </div>
                <!-- Email & Role/Specialty Dropdown -->
                <div class="form-row-2col">
                  <div class="input-group">
                    <label class="input-label" for="workEmail">
                      Professional / Institutional Email <span class="req-star">*</span>
                    </label>
                    <input class="text-input" id="workEmail" placeholder="name@institution.edu or clinic.org"
                      required="" type="email" />
                  </div>
                  <div class="input-group">
                    <label class="input-label" for="specialtyRole">
                      Clinical Role / Specialty <span class="req-star">*</span>
                    </label>
                    <div class="select-wrap">
                      <select class="select-input" id="specialtyRole" required="">
                        <option disabled="" selected="" value="">Select clinical or technical role</option>
                        <option value="glaucoma_specialist">Glaucoma Subspecialist / Consultant</option>
                        <option value="general_ophthalmologist">General Ophthalmologist</option>
                        <option value="optometrist">Optometrist / Ophthalmic Clinician</option>
                        <option value="trial_coordinator">Clinical Trial Coordinator / Research Fellow</option>
                        <option value="biomedical_engineer">Biomedical Engineer / Medical Physicist</option>
                        <option value="pacs_admin">Hospital IT / PACS Administrator</option>
                        <option value="academic_faculty">University Faculty / Postdoctoral Researcher</option>
                        <option value="other">Other Healthcare Professional</option>
                      </select>
                      <span class="material-symbols-outlined select-arrow-icon">expand_more</span>
                    </div>
                  </div>
                </div>
                <!-- Scope & Primary Topics (Multi-choice pills) -->
                <div class="input-group" style="padding-top: 0.25rem;">
                  <label class="input-label">Primary Areas of Interest (Select applicable)</label>
                  <div class="interests-flex" id="interestTags">
                    <label class="interest-checkbox-label">
                      <input name="interest" type="checkbox" value="Edge_Inference" />
                      <span class="interest-pill">
                        <span class="material-symbols-outlined" style="font-size: 14px;">memory</span>
                        Local Offline Edge Node
                      </span>
                    </label>
                    <label class="interest-checkbox-label">
                      <input name="interest" type="checkbox" value="Retrospective_Cohort" />
                      <span class="interest-pill">
                        <span class="material-symbols-outlined" style="font-size: 14px;">dataset</span>
                        Retrospective Cohort Testing
                      </span>
                    </label>
                    <label class="interest-checkbox-label">
                      <input name="interest" type="checkbox" value="DICOM_PACS" />
                      <span class="interest-pill">
                        <span class="material-symbols-outlined" style="font-size: 14px;">device_hub</span>
                        DICOM PACS Bridge
                      </span>
                    </label>
                    <label class="interest-checkbox-label">
                      <input name="interest" type="checkbox" value="Paper_Discussion" />
                      <span class="interest-pill">
                        <span class="material-symbols-outlined" style="font-size: 14px;">article</span>
                        SPI-OWL Architecture Paper
                      </span>
                    </label>
                    <label class="interest-checkbox-label">
                      <input name="interest" type="checkbox" value="Prototype_Access" />
                      <span class="interest-pill">
                        <span class="material-symbols-outlined" style="font-size: 14px;">biotech</span>
                        Research Workspace Demo
                      </span>
                    </label>
                  </div>
                </div>
                <!-- Message Textarea -->
                <div class="input-group">
                  <label class="input-label" for="clinicalMessage">
                    Inquiry Scope &amp; Equipment Context <span class="req-star">*</span>
                  </label>
                  <textarea class="textarea-input" id="clinicalMessage"
                    placeholder="Describe your clinical setting, equipment models in use (e.g., Topcon TRC-NW400, Zeiss Clarus 500, Canon CR-2), patient cohort scale, or specific algorithmic questions..."
                    required="" rows="4"></textarea>
                </div>
                <!-- Research Ethics & Data Confidentiality Consent -->
                <div class="consent-row">
                  <input class="consent-checkbox" id="researchConsent" required="" type="checkbox" />
                  <label class="consent-label" for="researchConsent">
                    I understand that <strong>FundusGuard AI</strong> is an investigational clinical decision-support
                    research project. I consent to technical correspondence and confirm that any sample data transmitted
                    adheres to applicable institutional patient privacy and de-identification regulations.
                  </label>
                </div>
                <!-- Form Action Buttons -->
                <div class="form-actions-row">
                  <button class="btn-reset" id="resetBtn" type="button">
                    <span class="material-symbols-outlined" style="font-size: 16px;">restart_alt</span>
                    <span>Clear Fields</span>
                  </button>
                  <button class="btn-submit-clinical" id="submitBtn" type="submit">
                    <span id="submitText">Submit Clinical Inquiry</span>
                    <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                  </button>
                </div>
              </form>
              <!-- Dynamic Confirmation Card -->
              <div class="confirmation-box hidden" id="confirmationNotice">
                <div class="confirm-title-row">
                  <span class="material-symbols-outlined"
                    style="color: var(--status-healthy); font-size: 24px;">verified</span>
                  <h3 class="confirm-title">Clinical Inquiry Received</h3>
                </div>
                <p class="confirm-text">
                  Thank you. Your dossier has been logged under inquiry reference <span class="token-highlight"
                    id="referenceCodeNumber">#FG-2025-0814</span>.
                  A confirmation has been queued for your institutional inbox. Our primary investigators review academic
                  requests systematically within 1–2 business days.
                </p>
                <div class="confirm-meta-row">
                  <span class="confirm-meta-item">
                    <span class="material-symbols-outlined"
                      style="font-size: 14px; color: var(--optic-disc-gold);">schedule</span>
                    Response Queue: Priority Active
                  </span>
                  <span class="confirm-meta-item">
                    <span class="material-symbols-outlined"
                      style="font-size: 14px; color: var(--status-healthy);">mark_email_read</span>
                    Copy dispatched to sender
                  </span>
                </div>
              </div>
            </div>
          </div>
          <!-- RIGHT COLUMN: Bento-Style Institutional Framework & Governance -->
          <div class="bento-column" id="institutional-framework">
            <!-- Bento Card 1: Academic Leadership & Research Lab -->
            <div class="bento-card">
              <div class="bento-head-split">
                <div>
                  <span class="bento-tag">Research Headquarters</span>
                  <h3 class="bento-h3">Department of CSE &amp; Biomedical Lab</h3>
                </div>
                <div class="icon-box-sq">
                  <span class="material-symbols-outlined">account_balance</span>
                </div>
              </div>
              <p class="bento-desc">
                Developed under formal university research protocols focusing on computer vision applications in
                non-invasive retinal biomicroscopy and cup-to-disc ratio (CDR) topography.
              </p>
              <div class="staff-box">
                <div class="staff-item">
                  <div class="staff-badge-circle accent-orange">KM</div>
                  <div>
                    <div class="staff-name">Krishnendu Mitra</div>
                    <div class="staff-role">Lead System Architect &amp; Student Developer</div>
                  </div>
                </div>
                <div class="staff-item border-top">
                  <div class="staff-badge-circle accent-gold">SM</div>
                  <div>
                    <div class="staff-name">Prof. Soumen Mukherjee</div>
                    <div class="staff-role">Research Faculty &amp; Academic Supervisor</div>
                  </div>
                </div>
              </div>
              <div class="bento-footer-status">
                <span style="display: flex; align-items: center; gap: 0.375rem;">
                  <span class="status-dot-sm"></span>
                  Review cycle: Mon–Fri
                </span>
                <span style="color: var(--on-surface-variant); font-weight: 500;">Kolkata / Global Inquiries</span>
              </div>
            </div>
            <!-- Bento Card 2: Institutional Collaboration Frameworks -->
            <div class="bento-card">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="material-symbols-outlined"
                  style="color: var(--primary-container); font-size: 20px;">hub</span>
                <h3 class="bento-h3">Collaboration Frameworks</h3>
              </div>
              <div style="display: flex; flex-direction: column; gap: 0.625rem;">
                <div class="collab-item">
                  <div class="collab-head">
                    <span class="collab-title">1. Non-Commercial Academic Access</span>
                    <span class="collab-tag" style="color: var(--optic-disc-gold);">No Cost</span>
                  </div>
                  <p class="bento-desc">
                    Complete access to model weights and the SPI-OWL segmentation pipeline for accredited ophthalmology
                    residency programs and university research centers.
                  </p>
                </div>
                <div class="collab-item">
                  <div class="collab-head">
                    <span class="collab-title">2. Multi-Cohort Blinded Validation</span>
                    <span class="collab-tag" style="color: var(--status-healthy);">IRB Ready</span>
                  </div>
                  <p class="bento-desc">
                    Joint study designs for benchmarking cup-to-disc boundary precision against OCT (Optical Coherence
                    Tomography) RNFL ground truth across diverse demographics.
                  </p>
                </div>
                <div class="collab-item">
                  <div class="collab-head">
                    <span class="collab-title">3. Hardware Interoperability Bench</span>
                    <span class="collab-tag" style="color: var(--on-surface-variant);">OEM Friendly</span>
                  </div>
                  <p class="bento-desc">
                    Calibration protocols for non-mydriatic desktop fundus cameras and smartphone ophthalmoscope
                    attachments for rural community triage settings.
                  </p>
                </div>
              </div>
            </div>
            <!-- Bento Card 3: Clinical Governance & Privacy Safeguards -->
            <div class="bento-card">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="material-symbols-outlined"
                  style="color: var(--status-healthy); font-size: 20px;">verified_user</span>
                <h3 class="bento-h3">Data Integrity &amp; Privacy Mandate</h3>
              </div>
              <ul class="mandate-list">
                <li>
                  <span class="material-symbols-outlined"
                    style="font-size: 16px; color: var(--optic-disc-gold); flex-shrink: 0; margin-top: 1px;">check_circle</span>
                  <span><strong style="color: var(--on-surface);">Zero-Retention Local Edge:</strong> Inference runs
                    entirely within on-premise browser memory or local Docker containers without phoning home.</span>
                </li>
                <li>
                  <span class="material-symbols-outlined"
                    style="font-size: 16px; color: var(--optic-disc-gold); flex-shrink: 0; margin-top: 1px;">check_circle</span>
                  <span><strong style="color: var(--on-surface);">Client-Side DICOM Stripping:</strong> Patient
                    identifiers (Tags 0010,0010 &amp; 0010,0020) are automatically scrubbed before optic cup
                    rendering.</span>
                </li>
                <li>
                  <span class="material-symbols-outlined"
                    style="font-size: 16px; color: var(--optic-disc-gold); flex-shrink: 0; margin-top: 1px;">check_circle</span>
                  <span><strong style="color: var(--on-surface);">Ethics Board Review Alignment:</strong> Compliant with
                    Helsinki Declaration standards for retrospective diagnostic software evaluations.</span>
                </li>
              </ul>
              <div class="direct-contacts-section">
                <span
                  style="font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">Direct
                  Directorship Contacts</span>
                <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                  <a class="direct-contact-link" href="mailto:support@fundusguard.ai">
                    <span class="link-flex-group">
                      <span class="material-symbols-outlined"
                        style="font-size: 16px; color: var(--primary-container);">mail</span>
                      <span>support@fundusguard.ai</span>
                    </span>
                    <span style="font-size: 11px; color: var(--text-secondary);">Clinical Inquiries</span>
                  </a>
                  <a class="direct-contact-link" href="mailto:krishnendumitra24@gmail.com">
                    <span class="link-flex-group">
                      <span class="material-symbols-outlined"
                        style="font-size: 16px; color: var(--secondary);">school</span>
                      <span>krishnendumitra24@gmail.com</span>
                    </span>
                    <span style="font-size: 11px; color: var(--text-secondary);">Academic Direct</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- Bottom Section: Frequently Asked Clinical & Technical Questions -->
      <%- faq %>
    </div>
  </main>
  <%- footer %>
</body>
<script src="../public/App.js" nonce="<%= nonce %>" ></script>
<% if (isHosted) { %>
  <script src="https://kidkrishkode.github.io/fundusguardai/assets/scripts/contact.js" nonce="<%= nonce %>"></script>
<% } else { %>
  <script src="../assets/scripts/contact.js" nonce="<%= nonce %>"></script>
<% } %>
</html>