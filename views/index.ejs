<!DOCTYPE html>
<html class="dark" lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta content="web_standard" name="shell-type" />
  <title version="1.0">FundusGuard Ai</title>
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="../assets/styles/App.css" />
  <link rel="stylesheet" href="../assets/styles/index.css" />
  <link rel="stylesheet" href="../public/App.css"/>

  <script src="../assets/scripts/App.js"></script>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="../assets/scripts/tailwind.js"></script>

</head>

<body
  class="bg-surface font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary">
  <%- header %>
  <main class="w-full pt-16 bg-surface">
    <div class="flex flex-col w-full">
      <!-- Atmospheric Glow Mesh & Dynamic Backing -->
      <div class="relative w-full overflow-hidden">
        <!-- Ambient Radial Lasers (contained) -->
        <div
          class="absolute -top-36 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-primary-container/20 via-secondary-container/10 to-transparent blur-[140px] pointer-events-none -z-10">
        </div>
        <div
          class="absolute top-[600px] -left-48 w-[520px] h-[520px] bg-glaucoma-critical/10 blur-[130px] pointer-events-none -z-10">
        </div>
        <div
          class="absolute top-[800px] -right-48 w-[560px] h-[560px] bg-optic-disc-gold/10 blur-[150px] pointer-events-none -z-10">
        </div>
        <!-- HERO SECTION -->
        <section
          class="relative w-full px-margin md:px-margin-desktop pt-8 pb-16 md:py-20 max-w-7xl mx-auto flex flex-col items-center text-center">
          <!-- Live Telemetry Pill -->
          <div
            class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-surface-container-high/90 border border-border-amber-glow shadow-[0_0_24px_rgba(245,158,11,0.15)] mb-6 transition-all hover:bg-surface-container-highest">
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-healthy opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-status-healthy"></span>
            </span>
            <span class="font-label-sm text-label-sm tracking-wide text-on-surface">SPI-OWL Engine v1.0 Live</span>
            <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
            <span class="font-label-sm text-label-sm text-optic-disc-gold font-semibold">99.42% Clinical
              Sensitivity</span>
            <span class="w-1 h-1 rounded-full bg-outline-variant hidden sm:inline-block"></span>
            <span class="font-label-sm text-label-sm text-text-secondary hidden sm:inline-block">Sub-50ms
              Inference</span>
          </div>
          <!-- Main Title -->
          <h1
            class="font-headline-xl text-headline-xl tracking-tight text-text-primary max-w-4xl mx-auto leading-none mb-6">
            Autonomous Glaucoma Risk Detection from Retinal Fundus Scans.
          </h1>
          <!-- Subheadline -->
          <p class="font-body-lg text-body-lg text-text-secondary max-w-2xl mx-auto mb-8 leading-relaxed">
            Clinical-grade deep learning vision transformer trained on 120,000+ multi-ethnic fundus photographs.
            Real-time optic disc/cup segmentation, CDR metric calculation, and Grad-CAM neuro-vascular heatmaps.
          </p>
          <!-- Action Group -->
          <div class="flex flex-wrap items-center justify-center gap-4 mb-4">
            <a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-primary-container via-secondary-container to-primary-container text-on-primary font-headline-md text-headline-md tracking-tight font-bold shadow-[0_0_28px_rgba(234,88,12,0.45)] hover:shadow-[0_0_36px_rgba(234,88,12,0.65)] hover:scale-[1.02] active:scale-[0.99] transition-all"
              data-path="workspace" href="#">
              <span>Launch AI Workspace</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
            <a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-surface-container-high/70 hover:bg-surface-container-highest text-on-surface font-headline-md text-headline-md tracking-tight font-medium border border-border-amber-glow hover:border-secondary transition-all"
              href="#atlas">
              <span class="material-symbols-outlined text-optic-disc-gold text-[18px]">auto_stories</span>
              <span>Explore Glaucoma Atlas</span>
            </a>
          </div>
          <!-- Micro Badges -->
          <div
            class="flex flex-wrap items-center justify-center gap-4 text-text-secondary font-label-sm text-label-sm pt-2">
            <span class="inline-flex items-center gap-1.5"><span
                class="material-symbols-outlined text-[15px] text-status-healthy">verified</span> Zero installation
              required</span>
            <span>•</span>
            <span class="inline-flex items-center gap-1.5"><span
                class="material-symbols-outlined text-[15px] text-optic-disc-gold">security</span> HIPAA &amp; GDPR
              Compliant</span>
            <span>•</span>
            <span class="inline-flex items-center gap-1.5"><span
                class="material-symbols-outlined text-[15px] text-secondary">database</span> DICOM PACS Ready</span>
          </div>
          <!-- Academic Accreditation Underline Strip -->
          <div
            class="mt-8 px-4 py-2 rounded-xl bg-surface-container-low/60 border border-border-subtle inline-flex items-center gap-2 text-left">
            <span class="material-symbols-outlined text-[16px] text-optic-disc-gold shrink-0">school</span>
            <p class="font-body-sm text-body-sm text-text-secondary">
              Developed with precision by <strong class="text-on-surface font-semibold">Krishnendu Mitra</strong>
              (System Developer) under the guidance of <strong class="text-on-surface font-semibold">Prof. Soumen
                Mukherjee</strong>.
            </p>
          </div>
          <!-- HERO SHOWCASE: INTERACTIVE DIAGNOSTIC SIMULATION HUD -->
          <div
            class="w-full mt-12 rounded-2xl bg-surface-container-lowest/80 border border-border-amber-glow shadow-[0_20px_60px_-15px_rgba(0,0,0,0.9)] backdrop-blur-2xl p-4 md:p-6 text-left relative overflow-hidden">
            <!-- Showcase Topbar -->
            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-border-subtle">
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-error"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-status-healthy"></span>
                </div>
                <span class="font-mono text-label-sm text-text-secondary pl-2 border-l border-border-subtle">RET-STUDIO
                  // SPI-OWL-CORE-ENGINE // PATIENT: #OD-94821</span>
              </div>
              <!-- Interactive Layer Toggles -->
              <div
                class="inline-flex p-1 rounded-xl bg-surface-container-high border border-border-subtle text-label-sm"
                id="layer-toggles">
                <button
                  class="tab-btn px-3 py-1.5 rounded-lg bg-primary-container text-on-primary font-medium shadow-sm transition-all"
                  data-layer="raw" type="button">RGB Fundus</button>
                <button class="tab-btn px-3 py-1.5 rounded-lg text-text-secondary hover:text-on-surface transition-all"
                  data-layer="contour" type="button">Optic Cup Contour</button>
                <button class="tab-btn px-3 py-1.5 rounded-lg text-text-secondary hover:text-on-surface transition-all"
                  data-layer="vessel" type="button">Vascular Mask</button>
                <button class="tab-btn px-3 py-1.5 rounded-lg text-text-secondary hover:text-on-surface transition-all"
                  data-layer="heatmap" type="button">Attention Heatmap</button>
              </div>
            </div>
            <!-- Split Grid: Fundus Inspection Stage + Live Neural Telemetry -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6 items-center">
              <!-- Optical Viewport (Left 7 Cols) -->
              <div
                class="lg:col-span-7 relative rounded-xl bg-surface-container-low overflow-hidden aspect-square sm:aspect-[4/3] flex items-center justify-center group border border-border-subtle">
                <!-- Simulated Fundus Canvas Container -->
                <div class="relative w-full h-full flex items-center justify-center p-3">
                  <img alt="Clinical Fundus Retinopathy Scan"
                    class="w-full h-full object-contain filter contrast-125 transition-all duration-500 rounded-lg"
                    id="fundus-img"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQYRc5FjxLwI7hIDmXNRFp8Stm7yQaCsbJLfNl7JQf9gW9sAWHJkGYLF4e-uQXmV-i2rBuo3vAOSXMWJcHQOX2adbfm2U3piTibwcH7s2CFh5GR5ZTTGOhKu6FLYeN7ws__4PILupR-m3INMFdzRHiSrMh1138J7yY9aom36N7H38vIWmh9HPElVXRdyGZznst-Aaey9FtQrD_rgj0CVTQOejin5O07PKjVOms8qwehyK2t5YqaDQn" />
                  <!-- Dynamic Canvas Overlay (Vector Contour & Laser Targeting HUD) -->
                  <svg class="absolute inset-0 w-full h-full pointer-events-none transition-opacity duration-300"
                    fill="none" id="canvas-overlay" viewbox="0 0 800 600">
                    <!-- Reticle targeting lines -->
                    <circle class="animate-spin" cx="530" cy="305" r="95" stroke="#FCD34D" stroke-dasharray="4 4"
                      stroke-width="1.8" style="transform-origin: 530px 305px; animation-duration: 25s; opacity: 0.85;">
                    </circle>
                    <circle class="shadow-sm" cx="530" cy="305" r="62" stroke="#EF4444" stroke-width="2.5"
                      style="filter: drop-shadow(0 0 8px rgba(239,68,68,0.8));"></circle>
                    <!-- ISNT Thinning Vector Arrows -->
                    <line marker-end="url(#arrow)" stroke="#EF4444" stroke-width="2" x1="530" x2="530" y1="367"
                      y2="420"></line>
                    <text fill="#EF4444" font-family="Inter" font-size="12" font-weight="600" x="545" y="415">Inferior
                      Rim Thinning (0.11mm)</text>
                    <!-- Crosshairs -->
                    <line opacity="0.6" stroke="#FCD34D" stroke-width="1" x1="500" x2="560" y1="305" y2="305"></line>
                    <line opacity="0.6" stroke="#FCD34D" stroke-width="1" x1="530" x2="530" y1="275" y2="335"></line>
                  </svg>
                  <!-- Live HUD Coordinate Marker -->
                  <div
                    class="absolute bottom-4 left-4 bg-surface/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-border-amber-glow font-mono text-[11px] text-text-secondary flex items-center gap-3">
                    <span class="flex items-center gap-1.5"><span
                        class="w-1.5 h-1.5 rounded-full bg-status-healthy"></span> FOV: 50° High-Res</span>
                    <span>Fovea: (320, 298)</span>
                    <span class="text-optic-disc-gold">Disc: (530, 305)</span>
                  </div>
                  <!-- Excavation Badge -->
                  <div
                    class="absolute top-4 right-4 bg-glaucoma-critical/20 backdrop-blur-md px-3 py-1 rounded-full border border-glaucoma-critical/40 text-glaucoma-critical font-label-sm text-label-sm font-semibold flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[14px]">warning</span>
                    Elevated Excavation Alert
                  </div>
                </div>
              </div>
              <!-- Neural Telemetry & Biometrics (Right 5 Cols) -->
              <div class="lg:col-span-5 flex flex-col gap-4">
                <!-- CDR Metric Diagnostic Card -->
                <div class="p-4 rounded-xl bg-surface-container-high/60 border border-border-amber-glow shadow-md">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-label-sm text-label-sm text-text-secondary uppercase tracking-wider">Cup-to-Disc
                      Ratio (CDR)</span>
                    <span
                      class="px-2 py-0.5 rounded-md bg-glaucoma-critical/20 text-glaucoma-critical font-label-sm text-label-sm font-bold">CRITICAL
                      &gt; 0.65</span>
                  </div>
                  <div class="flex items-baseline gap-3 mb-2">
                    <span class="font-headline-xl text-headline-xl text-glaucoma-critical font-bold">0.74</span>
                    <span class="font-body-sm text-body-sm text-text-secondary">Normal Baseline: 0.30 - 0.45</span>
                  </div>
                  <!-- Linear Meter Visualization -->
                  <div class="w-full bg-surface-container-lowest h-2.5 rounded-full overflow-hidden flex">
                    <div class="bg-status-healthy h-full" style="width: 45%;" title="Normal Range"></div>
                    <div class="bg-secondary-container h-full" style="width: 20%;" title="Borderline Suspect"></div>
                    <div class="bg-glaucoma-critical h-full relative" style="width: 35%;">
                      <span
                        class="absolute -top-1 right-2 w-1.5 h-4 bg-on-surface rounded-full shadow-[0_0_8px_#ffffff]"></span>
                    </div>
                  </div>
                  <div class="flex justify-between text-[10px] font-mono text-text-secondary mt-1">
                    <span>0.0 (Physiologic)</span>
                    <span>0.50 (Borderline)</span>
                    <span class="text-glaucoma-critical font-bold">0.74 (Current)</span>
                    <span>1.0</span>
                  </div>
                </div>
                <!-- ISNT Rule Breakdown Card -->
                <div class="p-4 rounded-xl bg-surface-container-high/60 border border-border-subtle">
                  <div class="flex items-center justify-between mb-2.5">
                    <span class="font-title-md text-title-md text-on-surface flex items-center gap-1.5">
                      <span class="material-symbols-outlined text-[18px] text-optic-disc-gold">donut_large</span>
                      ISNT Rule Conformity
                    </span>
                    <span class="font-label-sm text-label-sm text-glaucoma-critical font-medium">VIOLATION
                      DETECTED</span>
                  </div>
                  <p class="font-body-sm text-body-sm text-text-secondary mb-3">
                    Inferior neuroretinal rim should normally be thickest (I &gt; S &gt; N &gt; T). Patient exhibits
                    severe inferior notched depression.
                  </p>
                  <!-- ISNT Mini Bars -->
                  <div class="space-y-1.5 font-mono text-[11px]">
                    <div class="flex items-center justify-between">
                      <span class="text-text-secondary">Inferior Rim (I)</span>
                      <div class="w-32 bg-surface-container-lowest h-1.5 rounded-full overflow-hidden">
                        <div class="bg-glaucoma-critical h-full" style="width: 34%;"></div>
                      </div>
                      <span class="text-glaucoma-critical font-bold">0.11mm (Thin)</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-text-secondary">Superior Rim (S)</span>
                      <div class="w-32 bg-surface-container-lowest h-1.5 rounded-full overflow-hidden">
                        <div class="bg-secondary-container h-full" style="width: 68%;"></div>
                      </div>
                      <span class="text-on-surface">0.24mm</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-text-secondary">Nasal Rim (N)</span>
                      <div class="w-32 bg-surface-container-lowest h-1.5 rounded-full overflow-hidden">
                        <div class="bg-status-healthy h-full" style="width: 55%;"></div>
                      </div>
                      <span class="text-on-surface">0.19mm</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-text-secondary">Temporal Rim (T)</span>
                      <div class="w-32 bg-surface-container-lowest h-1.5 rounded-full overflow-hidden">
                        <div class="bg-status-healthy h-full" style="width: 42%;"></div>
                      </div>
                      <span class="text-on-surface">0.14mm</span>
                    </div>
                  </div>
                </div>
                <!-- Deep Learning Attention Matrix Status -->
                <div
                  class="p-3.5 rounded-xl bg-surface-container-high/40 border border-border-subtle flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-primary-container/20 flex items-center justify-center text-primary-container">
                      <span class="material-symbols-outlined text-[18px]">neurology</span>
                    </div>
                    <div>
                      <div class="font-label-md text-label-md text-on-surface">Grad-CAM Saliency</div>
                      <div class="font-body-sm text-body-sm text-text-secondary">Focus on Peripapillary Nerve Bundle
                      </div>
                    </div>
                  </div>
                  <span class="font-mono text-label-sm text-optic-disc-gold font-bold">98.7% Conf.</span>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- METRICS & VALIDATION PROOF GRID -->
        <section class="w-full px-margin md:px-margin-desktop py-12 max-w-7xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Stat 1 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-amber-glow hover:border-secondary transition-all flex flex-col justify-between group">
              <div class="flex items-center justify-between mb-4">
                <span
                  class="font-label-sm text-label-sm text-text-secondary uppercase tracking-widest">Sensitivity</span>
                <span
                  class="material-symbols-outlined text-optic-disc-gold text-[20px] group-hover:scale-110 transition-transform">verified_user</span>
              </div>
              <div>
                <div
                  class="font-headline-xl text-headline-xl text-text-primary font-bold group-hover:text-optic-disc-gold transition-colors">
                  99.42%</div>
                <div class="font-body-sm text-body-sm text-text-secondary mt-1">Cross-validated across REFUGE &amp;
                  RIM-ONE benchmark cohorts.</div>
              </div>
            </div>
            <!-- Stat 2 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-amber-glow hover:border-secondary transition-all flex flex-col justify-between group">
              <div class="flex items-center justify-between mb-4">
                <span class="font-label-sm text-label-sm text-text-secondary uppercase tracking-widest">Latency</span>
                <span
                  class="material-symbols-outlined text-secondary-container text-[20px] group-hover:scale-110 transition-transform">bolt</span>
              </div>
              <div>
                <div
                  class="font-headline-xl text-headline-xl text-text-primary font-bold group-hover:text-secondary transition-colors">
                  &lt; 42 ms</div>
                <div class="font-body-sm text-body-sm text-text-secondary mt-1">High-throughput TensorRT execution on
                  edge &amp; GPU cloud clusters.</div>
              </div>
            </div>
            <!-- Stat 3 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-amber-glow hover:border-secondary transition-all flex flex-col justify-between group">
              <div class="flex items-center justify-between mb-4">
                <span class="font-label-sm text-label-sm text-text-secondary uppercase tracking-widest">Training
                  Corpus</span>
                <span
                  class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">biotech</span>
              </div>
              <div>
                <div
                  class="font-headline-xl text-headline-xl text-text-primary font-bold group-hover:text-primary transition-colors">
                  120K+</div>
                <div class="font-body-sm text-body-sm text-text-secondary mt-1">Annotated ophthalmologic fundus scans
                  spanning 6 global clinical centers.</div>
              </div>
            </div>
            <!-- Stat 4 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-amber-glow hover:border-secondary transition-all flex flex-col justify-between group">
              <div class="flex items-center justify-between mb-4">
                <span class="font-label-sm text-label-sm text-text-secondary uppercase tracking-widest">CDR Precision
                  MAE</span>
                <span
                  class="material-symbols-outlined text-status-healthy text-[20px] group-hover:scale-110 transition-transform">tune</span>
              </div>
              <div>
                <div
                  class="font-headline-xl text-headline-xl text-text-primary font-bold group-hover:text-status-healthy transition-colors">
                  0.02</div>
                <div class="font-body-sm text-body-sm text-text-secondary mt-1">Mean absolute error against senior
                  fellowship-trained glaucologists.</div>
              </div>
            </div>
          </div>
        </section>
        <!-- CORE TECHNOLOGY: SPI-OWL ARCHITECTURE BENTO -->
        <section class="w-full px-margin md:px-margin-desktop py-16 max-w-7xl mx-auto">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
            <div>
              <span
                class="font-label-sm text-label-sm text-optic-disc-gold uppercase tracking-widest font-semibold flex items-center gap-1.5 mb-2">
                <span class="material-symbols-outlined text-[16px]">memory</span> Deep Architectural Rigor
              </span>
              <h2 class="font-headline-lg text-headline-lg text-text-primary">
                The SPI-OWL Retinal Perception Engine
              </h2>
            </div>
            <p class="font-body-md text-body-md text-text-secondary max-w-md">
              A dual-path transformer fused with spatial pyramid pooling, tailored explicitly for subtle optic nerve
              excavation and localized neuroretinal rim notching.
            </p>
          </div>
          <!-- Bento Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Bento 1: Vision Transformer -->
            <div
              class="p-6 md:p-8 rounded-2xl bg-surface-container-low/80 border border-border-amber-glow hover:border-primary-container transition-all flex flex-col justify-between group relative overflow-hidden">
              <div
                class="absolute -right-12 -top-12 w-40 h-40 bg-primary-container/10 rounded-full blur-2xl group-hover:bg-primary-container/20 transition-all pointer-events-none">
              </div>
              <div>
                <div
                  class="w-12 h-12 rounded-xl bg-primary-container/20 text-primary-container flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-[24px]">view_in_ar</span>
                </div>
                <h3 class="font-title-md text-title-md text-text-primary mb-3">SPI-OWL Vision Transformer</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed mb-6">
                  Multi-scale convolutional-attention hybrid architecture capable of simultaneous optic disc
                  localization and micro-vascular segmentation, impervious to myopic tilt or cataract blur.
                </p>
              </div>
              <!-- Tech Tag Strip -->
              <div class="pt-4 border-t border-border-subtle flex flex-wrap gap-2">
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Self-Attention
                  Head</span>
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Pyramid
                  Pooling</span>
              </div>
            </div>
            <!-- Bento 2: Automated CDR & ISNT Profiler -->
            <div
              class="p-6 md:p-8 rounded-2xl bg-surface-container-low/80 border border-border-amber-glow hover:border-secondary transition-all flex flex-col justify-between group relative overflow-hidden">
              <div
                class="absolute -right-12 -top-12 w-40 h-40 bg-secondary/10 rounded-full blur-2xl group-hover:bg-secondary/20 transition-all pointer-events-none">
              </div>
              <div>
                <div
                  class="w-12 h-12 rounded-xl bg-secondary-container/20 text-optic-disc-gold flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-[24px]">adjust</span>
                </div>
                <h3 class="font-title-md text-title-md text-text-primary mb-3">Automated CDR &amp; ISNT Profiler</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed mb-6">
                  Sub-pixel elliptical fitting isolates the physiological cup and neuroretinal rim. Instantly computes
                  vertical CDR, horizontal CDR, and detects sectorial rim loss with sub-0.02 MAE error.
                </p>
              </div>
              <!-- Tech Tag Strip -->
              <div class="pt-4 border-t border-border-subtle flex flex-wrap gap-2">
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Active
                  Contours</span>
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Micron
                  Accuracy</span>
              </div>
            </div>
            <!-- Bento 3: Explainable AI & Grad-CAM -->
            <div
              class="p-6 md:p-8 rounded-2xl bg-surface-container-low/80 border border-border-amber-glow hover:border-glaucoma-critical transition-all flex flex-col justify-between group relative overflow-hidden">
              <div
                class="absolute -right-12 -top-12 w-40 h-40 bg-glaucoma-critical/10 rounded-full blur-2xl group-hover:bg-glaucoma-critical/20 transition-all pointer-events-none">
              </div>
              <div>
                <div
                  class="w-12 h-12 rounded-xl bg-error-container/20 text-glaucoma-critical flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-[24px]">visibility</span>
                </div>
                <h3 class="font-title-md text-title-md text-text-primary mb-3">Explainable AI (XAI) Heatmaps</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed mb-6">
                  Full visual interpretability for clinicians. Gradient-weighted class activation mapping (Grad-CAM)
                  illuminates exact retinal nerve fiber layer (RNFL) defects and laminar pores driving each diagnosis.
                </p>
              </div>
              <!-- Tech Tag Strip -->
              <div class="pt-4 border-t border-border-subtle flex flex-wrap gap-2">
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Grad-CAM
                  v2</span>
                <span
                  class="px-2.5 py-1 rounded-md bg-surface-container-high text-on-surface font-mono text-[11px]">Clinician
                  Audit Ready</span>
              </div>
            </div>
          </div>
        </section>
        <!-- CLINICAL LAB ENVIRONMENT & PREVIEW (ATTACHED WORKSPACE HERO) -->
        <section class="w-full px-margin md:px-margin-desktop py-12 max-w-7xl mx-auto">
          <div
            class="rounded-2xl bg-surface-container-lowest border border-border-amber-glow p-6 md:p-10 relative overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-5 flex flex-col gap-4">
                <div
                  class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-optic-disc-gold font-label-sm text-label-sm w-fit border border-border-amber-glow">
                  <span class="material-symbols-outlined text-[15px]">clinical_notes</span> Clinical Validation Suite
                </div>
                <h2 class="font-headline-lg text-headline-lg text-text-primary">
                  Simulated in Modern Ophthalmic Telemedicine Labs
                </h2>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed">
                  Engineered to operate seamlessly on surgical heads-up display arrays, mobile fundus lenses, and
                  institutional PACS servers. Clinicians receive immediate automated risk categorization: Normal, Early
                  Glaucoma Suspect, or Advanced Cupping.
                </p>
                <div class="flex flex-col gap-2 pt-2">
                  <div class="flex items-center gap-2 font-body-sm text-body-sm text-on-surface">
                    <span class="material-symbols-outlined text-status-healthy text-[18px]">check_circle</span>
