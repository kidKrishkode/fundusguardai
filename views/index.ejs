                <div
                  class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent pointer-events-none">
                </div>
                <div
                  class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-label-sm text-on-surface bg-surface-glass backdrop-blur-md p-3 rounded-lg border border-border-subtle">
                  <span class="font-mono text-optic-disc-gold">HOSPITAL PACS CONSOLE DISPLAY</span>
                  <span class="text-text-secondary">Connected via TLS 1.3 / DICOM DIMSE</span>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- 3-STEP CLINICAL WORKFLOW -->
        <section class="w-full px-margin md:px-margin-desktop py-16 max-w-7xl mx-auto">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <span
              class="font-label-sm text-label-sm text-optic-disc-gold uppercase tracking-widest font-semibold">Triage in
              3 Steps</span>
            <h2 class="font-headline-lg text-headline-lg text-text-primary mt-2">Zero Friction. Diagnostic Assurance.
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
            <!-- Step 1 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-subtle relative flex flex-col justify-between">
              <div class="font-mono text-secondary text-headline-md font-bold mb-4">01</div>
              <div>
                <h3 class="font-title-md text-title-md text-on-surface mb-2">Ingest Retinal Imagery</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed">
                  Drag-and-drop JPEG, PNG, TIFF fundus captures or stream automated DICOM instances directly through
                  REST webhooks.
                </p>
              </div>
              <div
                class="mt-6 pt-4 border-t border-border-subtle flex items-center gap-2 text-text-secondary font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[16px] text-optic-disc-gold">cloud_upload</span>
                Native DICOM, PACS &amp; JPEG
              </div>
            </div>
            <!-- Step 2 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-amber-glow relative flex flex-col justify-between shadow-[0_0_20px_rgba(245,158,11,0.06)]">
              <div class="font-mono text-primary-container text-headline-md font-bold mb-4">02</div>
              <div>
                <h3 class="font-title-md text-title-md text-on-surface mb-2">Segment &amp; Quantify</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed">
                  SPI-OWL pipeline calculates vertical/horizontal cup-to-disc ratio (CDR), tests ISNT criteria, and
                  flags glaucomatous excavation.
                </p>
              </div>
              <div
                class="mt-6 pt-4 border-t border-border-subtle flex items-center gap-2 text-primary font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[16px]">electric_bolt</span>
                Instantaneous &lt; 42ms Latency
              </div>
            </div>
            <!-- Step 3 -->
            <div
              class="p-6 rounded-2xl bg-surface-container-low/70 border border-border-subtle relative flex flex-col justify-between">
              <div class="font-mono text-status-healthy text-headline-md font-bold mb-4">03</div>
              <div>
                <h3 class="font-title-md text-title-md text-on-surface mb-2">Certify &amp; Export</h3>
                <p class="font-body-md text-body-md text-text-secondary leading-relaxed">
                  Export clinician-verified PDF summaries with Grad-CAM overlays, automated ICD-10 H40.x billing codes,
                  and cryptographic audit hashes.
                </p>
              </div>
              <div
                class="mt-6 pt-4 border-t border-border-subtle flex items-center gap-2 text-status-healthy font-label-sm text-label-sm">
                <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                One-Click Clinical PDF Export
              </div>
            </div>
          </div>
        </section>
        <!-- RESEARCH ACCREDITATION & REPOSITORY STRIP -->
        <section class="w-full px-margin md:px-margin-desktop py-12 max-w-7xl mx-auto">
          <div
            class="rounded-2xl bg-gradient-to-r from-surface-container-high/90 via-surface-container-low/90 to-surface-container-high/90 border border-border-amber-glow p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
