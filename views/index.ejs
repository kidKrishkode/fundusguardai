                  <div class="flex items-center gap-2 font-body-sm text-body-sm text-on-surface">
                    <span class="material-symbols-outlined text-status-healthy text-[18px]">check_circle</span>
                    Peripapillary Atrophy (PPA) Boundary Tracing
                  </div>
                  <div class="flex items-center gap-2 font-body-sm text-body-sm text-on-surface">
                    <span class="material-symbols-outlined text-status-healthy text-[18px]">check_circle</span>
                    DICOM SR (Structured Report) Auto-Populated Output
                  </div>
                </div>
              </div>
              <!-- Lab Display Image Preview -->
