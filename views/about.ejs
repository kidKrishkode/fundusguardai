                  <span class="badge-status-published">Published</span>
                </td>
              </tr>
              <tr>
                <td>
                  <div class="table-cohort-title">
                    <span class="material-symbols-outlined text-gold" style="font-size: 18px;">cell_tower</span>
                    <span>Rural Primary Kiosk Telemedicine</span>
                  </div>
                </td>
                <td class="font-mono">2,410 Screens</td>
                <td class="font-mono text-healthy" style="font-weight:700;">0.986</td>
                <td class="font-mono">98.60%</td>
                <td class="font-mono">97.80%</td>
                <td class="font-mono text-gold">0.023</td>
                <td>
                  <span class="badge-status-ongoing">Ongoing Field Study</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <!-- Metric Gauges -->
        <div class="gauge-metrics-grid">
          <div class="gauge-card">
            <div class="gauge-visual">
              <svg class="gauge-svg" viewbox="0 0 36 36">
                <path class="gauge-bg-circle"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke-width="3.2"></path>
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke="var(--status-healthy)" stroke-dasharray="99, 100" stroke-linecap="round" stroke-width="3.2">
                </path>
              </svg>
              <span class="gauge-number">99%</span>
            </div>
            <div>
              <div class="gauge-title">Generalization Fidelity</div>
              <div class="gauge-sub">Consistent AUC across non-mydriatic camera brands</div>
            </div>
          </div>
          <div class="gauge-card">
            <div class="gauge-visual">
              <svg class="gauge-svg" viewbox="0 0 36 36">
                <path class="gauge-bg-circle"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke-width="3.2"></path>
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke="var(--optic-disc-gold)" stroke-dasharray="96, 100" stroke-linecap="round" stroke-width="3.2">
                </path>
              </svg>
              <span class="gauge-number">96%</span>
            </div>
            <div>
              <div class="gauge-title">Ophthalmologist Agreement</div>
              <div class="gauge-sub">Cohen's Kappa κ = 0.942 with glaucoma fellowship specialists</div>
            </div>
          </div>
          <div class="gauge-card">
            <div class="gauge-visual">
              <svg class="gauge-svg" viewbox="0 0 36 36">
                <path class="gauge-bg-circle"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke-width="3.2"></path>
                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none"
                  stroke="var(--accent-orange-light)" stroke-dasharray="98, 100" stroke-linecap="round"
                  stroke-width="3.2"></path>
              </svg>
              <span class="gauge-number">0.98</span>
            </div>
            <div>
              <div class="gauge-title">Dice Coefficient</div>
              <div class="gauge-sub">Optic disc and cup boundary overlap accuracy</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Medical Governance Pledge -->
    <section class="governance-section section-spacing">
      <div class="container">
        <div class="governance-container-box">
          <div class="governance-grid">
            <div class="governance-content">
              <div class="hero-badge">
                <span class="material-symbols-outlined" style="font-size: 15px;">gavel</span>
                <span>MEDICAL GOVERNANCE PLEDGE</span>
              </div>
              <h2 class="section-title">Committed to Responsible, Human-in-the-Loop Clinical AI</h2>
              <p class="section-subtitle">
                FundusGuard AI adheres strictly to the highest standards of international biomedical safety. We reject
                black-box diagnostics: every screening output is designed as a Decision Support System (CDSS) empowering
                licensed ophthalmologists and primary care clinicians, never replacing human clinical discernment.
              </p>
              <div class="compliance-triad">
                <div class="compliance-item">
                  <span class="material-symbols-outlined text-healthy" style="font-size: 20px;">check_circle</span>
                  <div>
                    <div class="compliance-title">HIPAA &amp; GDPR</div>
                    <div class="compliance-desc">Zero patient PII stored during edge execution</div>
                  </div>
                </div>
                <div class="compliance-item">
                  <span class="material-symbols-outlined text-healthy" style="font-size: 20px;">check_circle</span>
                  <div>
                    <div class="compliance-title">FDA IDE / CE-IVD</div>
                    <div class="compliance-desc">Designed to align with SaMD Grade II protocols</div>
                  </div>
                </div>
                <div class="compliance-item">
                  <span class="material-symbols-outlined text-healthy" style="font-size: 20px;">check_circle</span>
                  <div>
                    <div class="compliance-title">Algorithmic Fairness</div>
                    <div class="compliance-desc">Audited across pigmentary and ethnic variations</div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Inquiry Card -->
            <div class="inquiry-card">
              <h3 class="inquiry-title">Institutional Inquiry</h3>
              <p class="inquiry-text">
                Are you a hospital, research institution, or health ministry seeking to validate the SPI-OWL engine on
                local clinical cohorts?
              </p>
              <a class="btn-cta-primary" onclick="route('/contact');" style="justify-content: center; margin-top: 6px;">
                <span>Request Research Partnership</span>
                <span class="material-symbols-outlined" style="font-size: 16px;">send</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Experience the Future CTA -->
    <section class="cta-banner-section section-spacing">
      <div class="container">
        <div class="cta-banner-inner">
          <div class="cta-icon-circle">
            <span class="material-symbols-outlined" style="font-size: 32px;">neurology</span>
          </div>
          <div>
            <h2 class="section-title">Experience the Future of Ophthalmic Computing</h2>
            <p class="section-subtitle" style="margin: 0 auto;">
              Upload any standard color fundus photograph or DICOM study to test the SPI-OWL segmentation and CDR
              quantification engine in real-time.
            </p>
          </div>
          <div class="cta-buttons-wrap">
            <a class="btn-cta-primary" onclick="route('/workspace');">
              <span>Launch Live Detection Workspace</span>
              <span class="material-symbols-outlined" style="font-size: 18px;">biotech</span>
            </a>
            <a class="btn-secondary" onclick="route('/api');">
              <span class="material-symbols-outlined text-gold" style="font-size: 18px;">api</span>
              <span>API Docs &amp; PyTorch Checkpoints</span>
            </a>
            <a class="hero-link" onclick="route('/app');">
              <span class="material-symbols-outlined" style="font-size: 18px;">mobile_friendly</span>
              <span>Download Mobile App</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <%- footer %>
</body>
