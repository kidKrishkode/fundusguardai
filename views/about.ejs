              </div>
            </div>
            <div class="profile-footer">
              <div class="social-links">
                <a class="social-btn" href="https://sites.google.com/view/soumen-mukherjee/home" title="Google Scholar Profile">
                  <span class="material-symbols-outlined" style="font-size: 20px;">school</span>
                </a>
                <a class="social-btn" href="https://arxiv.org/" title="arXiv Publications">
                  <span class="material-symbols-outlined" style="font-size: 20px;">description</span>
                </a>
