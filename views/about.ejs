                <a class="social-btn" href="https://www.kaggle.com/labledata/datasets" title="Kaggle Models">
                  <span class="material-symbols-outlined" style="font-size: 20px;">smart_toy</span>
                </a>
                <a class="social-btn" href="https://kidkrishkode.vercel.app/" title="Developer Portfolio">
                  <span class="material-symbols-outlined" style="font-size: 20px;">person</span>
                </a>
              </div>
              <a class="profile-cta" onclick="route('/workspace');">
                <span>View Architecture Specs</span>
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
              </a>
            </div>
          </div>
          <!-- Academic Mentor Card -->
          <div class="profile-card">
            <div>
              <div class="profile-header">
                <div class="profile-left">
                  <div class="profile-avatar-ring">
                    <div class="profile-avatar-inner">
                        <% if (isHosted) { %>
                          <img alt="Prof. Soumen Mukherjee, Academic Mentor and Senior Research Advisor"
                          src="https://kidkrishkode.github.io/fundusguardai/assets/images/soumenSir.jpg" />
                        <% } else { %>
                            <img src="../assets/images/soumenSir.jpg" alt="Prof. Soumen Mukherjee, Academic Mentor and Senior Research Advisor"/>
                        <% } %>
                    </div>
                  </div>
                  <div>
                    <h3 class="profile-name">Prof. Soumen Mukherjee</h3>
                    <div class="profile-role">Academic Mentor &amp; Senior Research Advisor</div>
                  </div>
                </div>
                <span class="profile-tag">Research Guidance</span>
