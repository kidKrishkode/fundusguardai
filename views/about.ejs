              <div class="profile-competencies" style="margin-top: 16px;">
                <span class="competency-label">Specializations &amp; Academic Governance:</span>
                <div class="chips-group">
                  <span class="chip">Computational Intelligence</span>
                  <span class="chip">Medical Imaging Systems</span>
                  <span class="chip">Healthcare AI Ethics &amp; Bias Mitigation</span>
                  <span class="chip">Pattern Recognition</span>
