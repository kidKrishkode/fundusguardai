            <span>IRB Protocol Compliant Research</span>
          </div>
        </div>
      </div>
    </section>
    <!-- Engine Blueprint (SPI-OWL) -->
    <section class="blueprint-section section-spacing" id="spi-owl-engine">
      <div class="container">
        <div class="blueprint-top-bar">
          <div class="blueprint-header-row">
            <% if (isHosted) { %>
              <img alt="SPI-OWL Architectural Mascot Icon" class="blueprint-mascot-img"
                src="https://kidkrishkode.github.io/fundusguardai/public/logo1500.png" />
            <% } else { %>
                <img src="../public/logo1500.png" class="blueprint-mascot-img" alt="FundusGuardAi"/>
            <% } %>
            <span class="section-eyebrow" style="margin: 0;">Engine Blueprint</span>
          </div>
          <h2 class="section-title">The SPI-OWL Dual-Attention Mechanism</h2>
          <p class="section-subtitle">
            Why <strong style="color:var(--text-primary);">SPI-OWL</strong>? Inspired by the multi-directional octagonal
            web construction of spiders (<em class="text-gold">Spider Attention</em>) and the 270-degree hyper-vigilant
            optical acuity of owls (<em class="text-gold">Owl Vigilance</em>), the engine executes continuous
            multi-scale retinal inspection.
          </p>
        </div>
        <div class="blueprint-grid">
          <!-- Fundus Inspection Canvas Visual -->
          <div class="fundus-canvas-container">
            <div class="fundus-canvas-card">
              <div class="fundus-viewport">
                <% if (isHosted) { %>
                  <img alt="High Resolution Color Retinal Fundus Scan with Optic Disc &amp; Vascular Arcade"
                      class="fundus-img"
                      src="https://kidkrishkode.github.io/fundusguardai/assets/images/fundus.jpg" />
                <% } else { %>
                  <img src="../assets/images/fundus.jpg" class="fundus-img" alt="FundusGuardAi"/>
                <% } %>
                <svg class="fundus-svg-overlay" viewbox="0 0 400 400">
                  <circle class="pulse" cx="260" cy="205" fill="none" r="46" stroke="#FCD34D" stroke-dasharray="6,4"
                    stroke-width="2.5"></circle>
                  <circle cx="260" cy="205" fill="rgba(246, 96, 24, 0.25)" r="22" stroke="#f66018"
                    stroke-dasharray="4,2" stroke-width="2"></circle>
                  <line stroke="#FCD34D" stroke-width="1.5" x1="250" x2="270" y1="205" y2="205"></line>
                  <line stroke="#FCD34D" stroke-width="1.5" x1="260" x2="260" y1="195" y2="215"></line>
                  <line stroke="rgba(245, 158, 11, 0.4)" stroke-dasharray="2,3" stroke-width="1" x1="260" x2="380"
                    y1="205" y2="100"></line>
                  <line stroke="rgba(245, 158, 11, 0.4)" stroke-dasharray="2,3" stroke-width="1" x1="260" x2="380"
                    y1="205" y2="300"></line>
                  <line stroke="rgba(245, 158, 11, 0.4)" stroke-dasharray="2,3" stroke-width="1" x1="260" x2="140"
                    y1="205" y2="350"></line>
                  <line stroke="rgba(245, 158, 11, 0.4)" stroke-dasharray="2,3" stroke-width="1" x1="260" x2="100"
                    y1="205" y2="150"></line>
                </svg>
              </div>
              <div class="optical-telemetry-ribbon">
                <div style="display:flex;align-items:center;gap:6px;">
                  <span class="status-dot"></span>
                  <span style="color:var(--text-primary);font-weight:600;">Optic Disc: Detected</span>
                </div>
                <div class="text-gold" style="font-weight:700;">CDR Calculated: 0.48</div>
                <div class="text-healthy" style="font-weight:600;">ISNT: Normal</div>
              </div>
            </div>
            <div style="font-size:12px;color:var(--text-secondary);text-align:center;">
              Figure 1.2: Synthetic overlay of SPI-OWL radial coordinate projections across optic nerve head margin.
            </div>
          </div>
          <!-- 4 Stages Breakdown Stack -->
          <div class="stages-stack">
            <!-- Stage 1 -->
            <div class="stage-card">
              <div class="stage-top">
                <span class="stage-number">STAGE 01</span>
                <span class="material-symbols-outlined text-orange" style="font-size: 20px;">filter_center_focus</span>
              </div>
              <h3 class="stage-title">Spatial Retinal Transformer (Spi-Trans)</h3>
              <p class="stage-desc">
                Employs shifted-window self-attention to simultaneously isolate the global retinal vascular tree and
                localize the optic disc bounding box without downsampling artifacts.
              </p>
              <div class="stage-equation font-mono">
                Loss: Dice + Focal Tversky (α=0.7, β=0.3)
              </div>
            </div>
            <!-- Stage 2 -->
            <div class="stage-card">
              <div class="stage-top">
                <span class="stage-number">STAGE 02</span>
                <span class="material-symbols-outlined text-gold" style="font-size: 20px;">balance</span>
              </div>
              <h3 class="stage-title">ISNT Neuroretinal Rule Engine</h3>
              <p class="stage-desc">
                Automates morphological measurement of the neural rim. Verifies the cardinal ISNT law (Inferior ≥
                Superior ≥ Nasal ≥ Temporal rim thickness); violations alert clinicians immediately.
              </p>
              <div class="stage-equation font-mono">
                Conformity: Inferior (0.34mm) &gt; Sup (0.31mm)
              </div>
            </div>
            <!-- Stage 3 -->
            <div class="stage-card">
              <div class="stage-top">
                <span class="stage-number">STAGE 03</span>
                <span class="material-symbols-outlined text-orange" style="font-size: 20px;">hub</span>
              </div>
              <h3 class="stage-title">Multimodal Clinical Fusion</h3>
              <p class="stage-desc">
                Integrates fundus latent visual representations with non-image clinical biomarkers (patient age, IOP,
                corneal thickness, diabetes history) via gradient-boosted decision trees.
              </p>
              <div class="stage-equation font-mono">
                Ensemble: DenseNet-201 + XGBoost Fusion
              </div>
            </div>
            <!-- Stage 4 -->
            <div class="stage-card">
              <div class="stage-top">
                <span class="stage-number">STAGE 04</span>
                <span class="material-symbols-outlined text-healthy" style="font-size: 20px;">visibility</span>
              </div>
              <h3 class="stage-title">Grad-CAM++ Explainability (XAI)</h3>
              <p class="stage-desc">
                Provides real-time photorealistic gradient activation heatmaps overlaid onto the optic disc so reviewing
                ophthalmologists can immediately verify what the AI inspected.
              </p>
              <div class="stage-equation font-mono">
                Transparency: Zero Black-Box Decisions
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
