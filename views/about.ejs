<!DOCTYPE html>
<html class="dark" lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title version="1.0">About &amp; Clinical Architecture - FundusGuard AI</title>
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../public/App.css"/>
  <% if (isHosted) { %>
    <link rel="stylesheet" href="https://kidkrishkode.github.io/fundusguardai/assets/styles/about.css"/>
  <% } else { %>
    <link rel="stylesheet" href="../assets/styles/about.css" />
  <% } %>
</head>

<body>
  <%- header %>
  <main class="page-main">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="container">
        <!-- Breadcrumb Bar -->
        <div class="hero-grid">
          <div class="hero-content">
            <div class="hero-badge">
              <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span>
              <span>AUTONOMOUS RETINAL BIOMICROSCOPY</span>
            </div>
            <h1 class="hero-title">
              Democratizing Glaucoma Screening Through <span class="hero-title-highlight">Autonomous Multimodal
                AI</span>.
            </h1>
            <p class="hero-description">
              FundusGuard AI bridges clinical ophthalmology and ultra-low-latency edge computing to halt irreversible
              visual field loss. Driven by the proprietary <strong style="color:var(--text-primary);">SPI-OWL</strong>
              architecture, our system quantifies neuroretinal rim degradation with specialist-level precision on
              non-mydriatic fundus cameras.
            </p>
            <!-- Metrics Strip -->
            <div class="hero-metrics-grid">
              <div class="metric-card">
                <span class="metric-label">Clinical Sensitivity</span>
                <span class="metric-value text-healthy">99.42%</span>
                <span class="metric-sub">Gold-standard cohorts</span>
              </div>
              <div class="metric-card">
                <span class="metric-label">Inferencing Latency</span>
                <span class="metric-value text-gold">38.4ms</span>
                <span class="metric-sub">Edge TensorRT engine</span>
              </div>
              <div class="metric-card">
                <span class="metric-label">Optic Cup MAE</span>
                <span class="metric-value text-orange">0.019</span>
                <span class="metric-sub">Sub-pixel boundary CDR</span>
              </div>
              <div class="metric-card">
                <span class="metric-label">Cost Barrier</span>
                <span class="metric-value" style="color:var(--text-primary);">$0</span>
                <span class="metric-sub">Zero hardware lock-in</span>
              </div>
            </div>
            <!-- CTAs -->
            <div class="hero-cta-group">
              <a class="btn-cta-primary" href="#spi-owl-engine">
                <span>Explore Engine Architecture</span>
                <span class="material-symbols-outlined" style="font-size: 18px;">memory</span>
              </a>
              <a class="btn-secondary" onclick="route('/workspace');">
                <span class="material-symbols-outlined text-gold" style="font-size: 18px;">biotech</span>
                <span>Launch Live Workspace</span>
              </a>
              <a class="hero-link" href="#clinical-validation">
                <span>Read Validation Datasets</span>
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_downward</span>
              </a>
            </div>
          </div>
          <!-- Hero Graphic Preview -->
          <div class="hero-visual">
            <div class="visual-wrapper">
              <% if (isHosted) { %>
                <img alt="Futuristic AI Ophthalmology Workspace and Holographic Biomicroscopy Room"
                  class="visual-img"
                  src="https://kidkrishkode.github.io/fundusguardai/assets/images/hospital_pack.jpg" />
              <% } else { %>
                  <img src="../assets/images/hospital_pack.jpg" class="visual-img" alt="FundusGuardAi"/>
              <% } %>
              <div class="visual-overlay-gradient"></div>
              <div class="visual-floating-card">
                <div class="floating-card-left">
                  <div class="floating-icon-box">
                    <span class="material-symbols-outlined" style="font-size: 22px;">radar</span>
                  </div>
                  <div>
                    <div class="floating-meta-title">Clinical Inference Core</div>
                    <div class="floating-meta-sub">SPI-OWL Multi-Layer Spatial Transformer</div>
                  </div>
                </div>
                <div class="active-pill">
                  <span class="status-dot pulse"></span>
                  ACTIVE
                </div>
              </div>
              <div class="visual-top-badge">
                <span class="material-symbols-outlined" style="font-size: 14px;">shield</span>
                <span>ISO 13485 Research Grade</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Why We Built FundusGuard AI -->
    <section class="threat-section section-spacing">
      <div class="container">
        <div class="threat-header">
          <span class="section-eyebrow">The Global Threat</span>
          <h2 class="section-title">Why We Built FundusGuard AI</h2>
          <p class="section-subtitle" style="margin: 0 auto;">
            Glaucoma is often deemed the "silent thief of sight." Over 50% of people living with glaucoma in developed
            nations—and up to 90% in emerging economies—are completely unaware they have it until irreversible visual
            field deficit occurs.
          </p>
        </div>
        <div class="threat-grid">
          <!-- Card 1 -->
          <div class="threat-card">
            <div class="threat-icon-box threat-icon-critical">
              <span class="material-symbols-outlined" style="font-size: 26px;">personal_injury</span>
            </div>
            <h3 class="threat-title">Irreversible Retinal Ganglion Cell Loss</h3>
            <p class="threat-desc">
              Unlike cataracts, once retinal nerve fiber layers (RNFL) atrophy, structural vision cannot be restored.
              High intraocular pressure compresses the optic nerve head, demanding early intervention before symptomatic
              visual field defects emerge.
            </p>
            <div class="threat-stat text-critical">
              <span class="material-symbols-outlined" style="font-size: 16px;">trending_up</span>
              <span>80M+ Patients worldwide by 2040</span>
            </div>
          </div>
          <!-- Card 2 -->
          <div class="threat-card">
            <div class="threat-icon-box threat-icon-gold">
              <span class="material-symbols-outlined" style="font-size: 26px;">medical_services</span>
            </div>
            <h3 class="threat-title">The Ophthalmology Specialist Desert</h3>
            <p class="threat-desc">
              In rural and developing health systems, the ratio of ophthalmologists to at-risk population drops to 1 per
              250,000 citizens. Advanced OCT machines cost upwards of $65,000, concentrating screening capacity strictly
              in elite tertiary hospitals.
            </p>
            <div class="threat-stat text-gold">
              <span class="material-symbols-outlined" style="font-size: 16px;">location_off</span>
              <span>90% Undetected in rural geographies</span>
            </div>
          </div>
          <!-- Card 3 -->
          <div class="threat-card">
            <div class="threat-icon-box threat-icon-healthy">
              <span class="material-symbols-outlined" style="font-size: 26px;">electric_bolt</span>
            </div>
            <h3 class="threat-title">The Zero-Friction Edge Solution</h3>
            <p class="threat-desc">
              FundusGuard AI runs locally on low-cost tablets, off-the-shelf laptops, or edge microprocessors connected
              to low-cost fundus cameras. Primary health workers can conduct full diagnostic screening in under 1 minute
              without cloud reliance.
            </p>
            <div class="threat-stat text-healthy">
              <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span>
              <span>Autonomous Offline Triage Capable</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Academic Leadership & Advisory -->
    <section class="team-section section-spacing">
      <div class="container">
        <div style="margin-bottom: 28px;">
          <span class="section-eyebrow">Academic Lineage</span>
          <h2 class="section-title">Leadership, Architects &amp; Scientific Advisory</h2>
          <p class="section-subtitle">
            Engineered as a high-impact research initiative combining deep algorithmic vision engineering with seasoned
            university mentorship in biomedical computing.
          </p>
        </div>
