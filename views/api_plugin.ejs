            copyNodeBtn.addEventListener("click", () => {
              navigator.clipboard.writeText(nodeCmdDisplay.textContent).then(() => {
                copyNodeText.textContent = "Copied!";
                setTimeout(() => { copyNodeText.textContent = "Copy"; }, 2000);
              });
            });
          }

          // Python package tabs switcher
          const pyTabs = document.querySelectorAll(".py-tab-btn");
          const pyCmdDisplay = document.getElementById("py-install-cmd");
          const copyPyBtn = document.getElementById("copy-py-btn");
          const copyPyText = document.getElementById("copy-py-text");

          pyTabs.forEach(tab => {
            tab.addEventListener("click", () => {
              pyTabs.forEach(t => {
                t.classList.remove("text-primary", "bg-surface-container-high");
                t.classList.add("text-text-secondary");
              });
              tab.classList.add("text-primary", "bg-surface-container-high");
              tab.classList.remove("text-text-secondary");
              if (pyCmdDisplay) {
                pyCmdDisplay.textContent = tab.getAttribute("data-cmd");
              }
            });
          });

          if (copyPyBtn && pyCmdDisplay && copyPyText) {
            copyPyBtn.addEventListener("click", () => {
              navigator.clipboard.writeText(pyCmdDisplay.textContent).then(() => {
                copyPyText.textContent = "Copied!";
                setTimeout(() => { copyPyText.textContent = "Copy"; }, 2000);
              });
            });
          }
        })();
      </script>
    </main>
    <%- footer %>
      <script>(function () { const toggleBtn = document.getElementById('theme-toggle-btn'); const toggleIcon = document.getElementById('theme-toggle-icon'); const html = document.documentElement; function updateIcon(isDark) { if (toggleIcon) { toggleIcon.textContent = isDark ? 'light_mode' : 'dark_mode'; } } const storedTheme = localStorage.getItem('fg_theme'); const isDarkInit = storedTheme ? storedTheme === 'dark' : true; if (isDarkInit) { html.classList.add('dark'); } else { html.classList.remove('dark'); } updateIcon(isDarkInit); if (toggleBtn) { toggleBtn.addEventListener('click', function () { const isDark = html.classList.toggle('dark'); localStorage.setItem('fg_theme', isDark ? 'dark' : 'light'); updateIcon(isDark); }); } const nav = document.querySelector('nav[data-active-classes]'); if (nav) { const activeClasses = (nav.getAttribute('data-active-classes') || '').split(' ').filter(Boolean); const currentPath = window.location.pathname.toLowerCase(); nav.querySelectorAll('a[data-path]').forEach(link => { const path = link.getAttribute('data-path'); const href = link.getAttribute('href') || ''; if (currentPath.includes(path) || currentPath.endsWith(href.replace('./', '')) || (path === 'api-docs' && (currentPath.endsWith('api.html') || currentPath === '' || currentPath.endsWith('/')))) { activeClasses.forEach(c => link.classList.add(c)); } }); } })();</script>
</body>

