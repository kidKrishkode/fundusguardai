<header class="site-header" id="header">
    <div class="header-inner">
        <div class="brand-group">
            <a class="brand-link" data-path="home" onclick="route('/index');">
                {{#if isHosted}}
                    <img alt="favicon" class="brand-logo-img" src="https://kidkrishkode.github.io/fundusguardai/public/favicon.ico" />
                {{else}}
                    <img src="../public/favicon.ico" class="brand-logo-img" alt="favicon" />
                {{/if}}
                <div class="brand-meta">
                    <div class="brand-title-row">
                        <span class="brand-title-primary">FundusGuard</span>
                        <span class="brand-title-gold">AI</span>
                    </div>
                    <span class="brand-tagline">Retinal Diagnostics</span>
                </div>
            </a>
            <span class="version-badge">
                <span class="status-dot"></span>
                v1.0 SPI-OWL
            </span>
        </div>
        <nav class="main-nav">
            <a class="nav-link" data-path="home" onclick="route('/index');">Home</a>
            <a class="nav-link" data-path="workspace" onclick="route('/workspace');">Workspace</a>
            <a class="nav-link" data-path="about" onclick="route('/about');">About</a>
            <a class="nav-link" data-path="api-docs" onclick="route('/api_plugin');">API Docs</a>
            <a class="nav-link" data-path="app-download" onclick="route('/app');">App Download</a>
            <a class="nav-link" data-path="contact" onclick="route('/contact');">Contact</a>
        </nav>
        <div class="header-actions">
            <a class="btn-cta-primary" data-path="workspace" onclick="route('/workspace');">
                <span>Launch Workspace</span>
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
            </a>
            <div class="header-profile-cluster">
                <div class="avatar-wrapper">
                    {{#if isHosted}}
                        <img alt="Profile" class="avatar-img"
                        src="https://kidkrishkode.github.io/fundusguardai/assets/images/dp.jpg" />
                    {{else}}
                        <img src="../assets/images/dp.jpg" class="avatar-img" alt="User Dp" />
                    {{/if}}
                    <span class="avatar-badge"></span>
                </div>
                <button aria-label="Toggle mobile menu" class="nav-toggle-btn" id="mobile-nav-toggle" type="button">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>
        </div>
    </div>
    <!-- Mobile Drawer -->
    <div class="mobile-drawer" id="mobile-drawer">
        <div class="mobile-telemetry">
            <span style="display:flex;align-items:center;gap:6px;">
                <span class="status-dot pulse"></span>
                Neural Telemetry: Live (42ms)
            </span>
            <span class="mobile-telemetry-badge">SPI-OWL v1.0</span>
        </div>
        <a class="mobile-link" data-path="home" onclick="route('/index');">Home</a>
        <a class="mobile-link" data-path="workspace" onclick="route('/workspace');">Workspace</a>
        <a class="mobile-link" data-path="about" onclick="route('/about');">About</a>
        <a class="mobile-link" data-path="api-docs" onclick="route('/api_plugin');">API Docs</a>
        <a class="mobile-link" data-path="app-download" onclick="route('/app');">App Download</a>
        <a class="mobile-link" data-path="contact" onclick="route('/contact');">Contact</a>
        <div style="padding-top: 6px;">
            <a class="btn-cta-primary" data-path="workspace" onclick="route('/workspace');"
                style="width: 100%; justify-content: center;">
                <span>Launch Diagnostic Studio</span>
                <span class="material-symbols-outlined" style="font-size: 16px;">biotech</span>
            </a>
        </div>
    </div>
</header>